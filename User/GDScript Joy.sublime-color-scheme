{
    "name": "GDScript Joy",
    "variables": {
        "background": "#000000",
        "foreground": "#CDD6F4",
        "muted": "#737D96",
        "soft": "#939CB3",
        "rose": "#F38BA8",
        "peach": "#FAB387",
        "gold": "#F9C97C",
        "green": "#A6E3A1",
        "teal": "#94E2D5",
        "cyan": "#89DCEB",
        "blue": "#89B4FA",
        "lavender": "#B4BEFE",
        "mauve": "#CBA6F7",
        "pink": "#F5C2E7",
        "red": "#F26D78",
        "warning": "#F2CDCD"
    },
    "globals": {
        "background": "var(background)",
        "foreground": "var(foreground)",
        "caret": "#F5E0DC",
        "block_caret": "#F5E0DC",
        "selection": "#30364F",
        "selection_border": "#4A526E",
        "inactive_selection": "#252A3A",
        "inactive_selection_border": "#343A50",
        "line_highlight": "#151925",
        "find_highlight": "#F9C97C",
        "find_highlight_foreground": "#0F111A",
        "guide": "#22283A",
        "active_guide": "#4A526E",
        "stack_guide": "#343B52",
        "gutter": "var(background)",
        "gutter_foreground": "#505970",
        "fold_marker": "#69738D",
        "brackets_foreground": "var(blue)",
        "brackets_options": "underline",
        "misspelling": "var(rose)",
        "accent": "var(blue)"
    },
    "rules": [
        {
            "name": "Comments",
            "scope": "comment.line.number-sign.gdscript, comment.line.region.gdscript",
            "foreground": "var(muted)",
            "font_style": "italic"
        },
        {
            "name": "Documentation comments",
            "scope": "comment.line.documentation.gdscript",
            "foreground": "var(soft)"
        },
        {
            "name": "Documentation tags",
            "scope": "meta.tag.documentation.gdscript, markup.raw.inline.gdscript",
            "foreground": "var(cyan)"
        },
        {
            "name": "Comment punctuation",
            "scope": "punctuation.definition.comment.gdscript, punctuation.definition.comment.documentation.gdscript",
            "foreground": "#596278"
        },
        {
            "name": "Regions",
            "scope": "keyword.other.region.gdscript",
            "foreground": "var(lavender)",
            "font_style": "bold"
        },
        {
            "name": "Critical comment markers",
            "scope": "markup.warning.critical.comment.gdscript",
            "foreground": "var(red)",
            "font_style": "bold"
        },
        {
            "name": "Warning comment markers",
            "scope": "markup.warning.comment.gdscript",
            "foreground": "var(gold)",
            "font_style": "bold"
        },
        {
            "name": "Notice comment markers",
            "scope": "markup.note.comment.gdscript",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "name": "Links",
            "scope": "markup.underline.link.gdscript, markup.underline.link.class.documentation.gdscript",
            "foreground": "var(blue)",
            "font_style": "underline"
        },
        {
            "name": "Control flow",
            "scope": "keyword.control.gdscript, keyword.control.conditional.gdscript, keyword.control.loop.gdscript, keyword.control.match.gdscript, keyword.control.flow.gdscript, keyword.control.flow.async.gdscript",
            "foreground": "var(rose)",
            "font_style": "bold"
        },
        {
            "name": "Declaration keywords",
            "scope": "storage.type.declaration.gdscript, storage.type.class.gdscript, storage.type.function.gdscript, storage.type.function.lambda.gdscript, storage.type.signal.gdscript, storage.type.enum.gdscript, storage.type.constant.gdscript, storage.type.variable.gdscript, storage.modifier.class-name.gdscript, storage.modifier.extends.gdscript, storage.modifier.static.gdscript",
            "foreground": "var(mauve)"
        },
        {
            "name": "Language variables",
            "scope": "variable.language.gdscript",
            "foreground": "var(rose)",
            "font_style": "italic"
        },
        {
            "name": "Reserved future keywords",
            "scope": "keyword.reserved.future.gdscript",
            "foreground": "var(warning)",
            "font_style": "stippled_underline"
        },
        {
            "name": "Logical and type operators",
            "scope": "keyword.operator.word.logical.gdscript, keyword.operator.word.type.gdscript, keyword.operator.word.membership.gdscript",
            "foreground": "var(blue)",
            "font_style": "italic"
        },
        {
            "name": "Symbolic operators",
            "scope": "keyword.operator.assignment.gdscript, keyword.operator.assignment.default.gdscript, keyword.operator.assignment.inferred.gdscript, keyword.operator.assignment.accessor.gdscript, keyword.operator.comparison.gdscript, keyword.operator.logical.gdscript, keyword.operator.arithmetic.gdscript, keyword.operator.bitwise.gdscript, keyword.operator.variadic.gdscript, keyword.operator.variadic-or-rest.gdscript, keyword.operator.range-or-rest.gdscript",
            "foreground": "var(blue)"
        },
        {
            "name": "Debug keyword",
            "scope": "keyword.other.debug.gdscript",
            "foreground": "var(peach)",
            "font_style": "bold"
        },
        {
            "name": "Assertion keyword",
            "scope": "keyword.other.assert.gdscript",
            "foreground": "var(peach)",
            "font_style": "bold"
        },
        {
            "name": "Preload keyword",
            "scope": "keyword.other.preload.gdscript",
            "foreground": "var(cyan)",
            "font_style": "bold"
        },
        {
            "name": "Pattern binding keyword",
            "scope": "keyword.other.binding.pattern.gdscript",
            "foreground": "var(mauve)"
        },
        {
            "name": "Annotations — export",
            "scope": "storage.modifier.annotation.export.gdscript",
            "foreground": "var(pink)"
        },
        {
            "name": "Annotations — execution",
            "scope": "storage.modifier.annotation.execution.gdscript",
            "foreground": "var(mauve)",
            "font_style": "bold"
        },
        {
            "name": "Annotations — networking",
            "scope": "storage.modifier.annotation.network.gdscript",
            "foreground": "var(rose)",
            "font_style": "bold"
        },
        {
            "name": "Annotations — warning control",
            "scope": "storage.modifier.annotation.warning.gdscript",
            "foreground": "var(gold)"
        },
        {
            "name": "Unknown or future annotations",
            "scope": "entity.other.attribute-name.annotation.unknown.gdscript",
            "foreground": "var(warning)"
        },
        {
            "name": "Annotation sigil",
            "scope": "punctuation.definition.annotation.gdscript",
            "foreground": "#D48BE8"
        },
        {
            "name": "Global class names",
            "scope": "entity.name.type.class.global.gdscript, entity.name.type.class.local.gdscript, entity.name.type.enum.gdscript",
            "foreground": "var(blue)",
            "font_style": "bold"
        },
        {
            "name": "Built-in and conventional class names",
            "scope": "support.class.engine-or-user.gdscript",
            "foreground": "var(blue)"
        },
        {
            "name": "Primitive types",
            "scope": "support.type.builtin.primitive.gdscript, storage.type.builtin.primitive.gdscript",
            "foreground": "var(cyan)",
            "font_style": "italic"
        },
        {
            "name": "Math types",
            "scope": "support.type.builtin.math.gdscript, storage.type.builtin.math.gdscript",
            "foreground": "#74C7EC"
        },
        {
            "name": "Collection types",
            "scope": "support.type.builtin.collection.gdscript, storage.type.builtin.collection.gdscript",
            "foreground": "var(lavender)"
        },
        {
            "name": "Core types",
            "scope": "support.type.builtin.core.gdscript, storage.type.builtin.core.gdscript",
            "foreground": "var(teal)"
        },
        {
            "name": "User types in annotations",
            "scope": "storage.type.user.gdscript",
            "foreground": "var(blue)"
        },
        {
            "name": "Function declarations",
            "scope": "entity.name.function.gdscript, entity.name.function.lambda.gdscript",
            "foreground": "var(gold)",
            "font_style": "bold"
        },
        {
            "name": "Lifecycle callbacks",
            "scope": "entity.name.function.lifecycle.gdscript",
            "foreground": "var(green)",
            "font_style": "bold"
        },
        {
            "name": "Private function declarations",
            "scope": "entity.name.function.private.gdscript",
            "foreground": "#E6B673",
            "font_style": "bold"
        },
        {
            "name": "Signal declarations",
            "scope": "entity.name.function.signal.gdscript",
            "foreground": "var(pink)",
            "font_style": "bold"
        },
        {
            "name": "Accessors",
            "scope": "entity.name.function.accessor.gdscript",
            "foreground": "var(teal)",
            "font_style": "bold"
        },
        {
            "name": "Accessor implementation references",
            "scope": "variable.function.accessor.gdscript",
            "foreground": "var(teal)",
            "font_style": "italic"
        },
        {
            "name": "Direct function calls",
            "scope": "entity.name.function.call.gdscript",
            "foreground": "var(gold)"
        },
        {
            "name": "Method calls",
            "scope": "entity.name.function.method.call.gdscript",
            "foreground": "var(teal)"
        },
        {
            "name": "Built-in math and random calls",
            "scope": "support.function.builtin.math.gdscript, support.function.builtin.random.gdscript",
            "foreground": "var(green)"
        },
        {
            "name": "Built-in conversion and runtime calls",
            "scope": "support.function.builtin.conversion.gdscript, support.function.builtin.runtime.gdscript",
            "foreground": "#8BD5CA"
        },
        {
            "name": "Built-in resource calls",
            "scope": "support.function.builtin.resource.gdscript",
            "foreground": "var(cyan)"
        },
        {
            "name": "Output and diagnostic calls",
            "scope": "support.function.builtin.output.gdscript",
            "foreground": "var(peach)"
        },
        {
            "name": "Deprecated built-ins",
            "scope": "support.function.builtin.deprecated.gdscript, invalid.deprecated.keyword.gdscript",
            "foreground": "#B8A4A9",
            "font_style": "stippled_underline"
        },
        {
            "name": "Engine singletons",
            "scope": "support.variable.singleton.gdscript",
            "foreground": "var(cyan)",
            "font_style": "bold"
        },
        {
            "name": "Variable declarations",
            "scope": "variable.other.declaration.gdscript",
            "foreground": "var(lavender)",
            "font_style": "bold"
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter.gdscript, variable.parameter.variadic.gdscript, variable.parameter.accessor.gdscript",
            "foreground": "var(peach)"
        },
        {
            "name": "Loop and pattern bindings",
            "scope": "variable.other.binding.loop.gdscript, variable.other.binding.pattern.gdscript",
            "foreground": "var(peach)",
            "font_style": "bold"
        },
        {
            "name": "Members",
            "scope": "variable.other.member.gdscript",
            "foreground": "#B7D7E8"
        },
        {
            "name": "Ordinary variables",
            "scope": "variable.other.readwrite.gdscript",
            "foreground": "var(foreground)"
        },
        {
            "name": "Constants",
            "scope": "entity.name.constant.gdscript, variable.other.constant.gdscript, variable.other.constant.enum.gdscript",
            "foreground": "var(gold)",
            "font_style": "bold"
        },
        {
            "name": "Dictionary keys",
            "scope": "constant.other.key.dictionary.gdscript",
            "foreground": "var(lavender)"
        },
        {
            "name": "Discard wildcard",
            "scope": "variable.language.discard.gdscript",
            "foreground": "var(muted)",
            "font_style": "italic"
        },
        {
            "name": "Regular strings",
            "scope": "string.quoted.double.gdscript, string.quoted.single.gdscript, string.quoted.triple.double.gdscript, string.quoted.triple.single.gdscript, string.quoted.double.raw.gdscript, string.quoted.single.raw.gdscript, string.quoted.triple.double.raw.gdscript, string.quoted.triple.single.raw.gdscript",
            "foreground": "var(green)"
        },
        {
            "name": "StringName literals",
            "scope": "string.quoted.double.string-name.gdscript",
            "foreground": "var(pink)"
        },
        {
            "name": "NodePath literals and shorthands",
            "scope": "string.quoted.double.node-path.gdscript, string.quoted.double.node-shorthand.gdscript, variable.other.node-path.shorthand.gdscript, variable.other.node-path.unique.gdscript",
            "foreground": "var(cyan)"
        },
        {
            "name": "String delimiters and prefixes",
            "scope": "punctuation.definition.string.gdscript, punctuation.definition.string.begin.gdscript, punctuation.definition.string.end.gdscript, punctuation.definition.string-name.gdscript, punctuation.definition.node-path.gdscript, punctuation.definition.node-shorthand.gdscript, punctuation.definition.unique-node.gdscript, storage.type.string.raw.gdscript",
            "foreground": "#70B9A8"
        },
        {
            "name": "Escapes",
            "scope": "constant.character.escape.gdscript, constant.character.escape.raw.gdscript, constant.character.escape.brace.gdscript",
            "foreground": "var(peach)"
        },
        {
            "name": "Format placeholders",
            "scope": "constant.other.placeholder.printf.gdscript, constant.other.placeholder.format.gdscript",
            "foreground": "var(gold)",
            "font_style": "bold"
        },
        {
            "name": "Resource paths",
            "scope": "support.constant.resource-path.gdscript",
            "foreground": "var(cyan)"
        },
        {
            "name": "Decimal integers",
            "scope": "constant.numeric.integer.decimal.gdscript",
            "foreground": "var(peach)"
        },
        {
            "name": "Hexadecimal integers",
            "scope": "constant.numeric.integer.hexadecimal.gdscript",
            "foreground": "#F2A6A6"
        },
        {
            "name": "Binary integers",
            "scope": "constant.numeric.integer.binary.gdscript",
            "foreground": "var(mauve)"
        },
        {
            "name": "Floating-point numbers",
            "scope": "constant.numeric.float.gdscript, constant.numeric.float.exponent.gdscript",
            "foreground": "var(peach)"
        },
        {
            "name": "Boolean and null literals",
            "scope": "constant.language.boolean.gdscript, constant.language.null.gdscript",
            "foreground": "var(rose)",
            "font_style": "italic"
        },
        {
            "name": "Mathematical language constants",
            "scope": "constant.language.numeric.gdscript",
            "foreground": "var(gold)",
            "font_style": "bold"
        },
        {
            "name": "Punctuation",
            "scope": "source.gdscript punctuation",
            "foreground": "#7B849C"
        },
        {
            "name": "Line continuations",
            "scope": "punctuation.separator.continuation.line.gdscript",
            "foreground": "var(rose)",
            "font_style": "bold"
        },
        {
            "name": "Illegal source",
            "scope": "invalid.illegal.gdscript, invalid.illegal.character.gdscript, invalid.illegal.escape.gdscript, invalid.illegal.unmatched-delimiter.gdscript, invalid.illegal.stray-backslash.gdscript, invalid.illegal.unclosed-string.gdscript, invalid.illegal.unclosed-parameters.gdscript, invalid.illegal.merge-conflict.gdscript",
            "foreground": "#FFF2F4",
            "background": "#7D2637",
            "font_style": "bold"
        }
    ]
}
