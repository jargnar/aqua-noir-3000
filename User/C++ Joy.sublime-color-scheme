{
  "name": "C++ Joy",
  "variables": {
    "background": "#000000",
    "foreground": "#CDD6F4",
    "muted": "#737D96",
    "soft": "#939CB3",
    "rose": "#F38BA8",
    "peach": "#FAB387",
    "gold": "#F9C97C",
    "green": "#A6E3A1",
    "teal": "#94E2D5",
    "cyan": "#89DCEB",
    "blue": "#89B4FA",
    "lavender": "#B4BEFE",
    "mauve": "#CBA6F7",
    "pink": "#F5C2E7",
    "red": "#F26D78",
    "warning": "#F2CDCD"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#F5E0DC",
    "block_caret": "#F5E0DC",
    "selection": "#30364F",
    "selection_border": "#4A526E",
    "inactive_selection": "#252A3A",
    "inactive_selection_border": "#343A50",
    "line_highlight": "#151925",
    "find_highlight": "#F9C97C",
    "find_highlight_foreground": "#0F111A",
    "guide": "#22283A",
    "active_guide": "#4A526E",
    "stack_guide": "#343B52",
    "gutter": "var(background)",
    "gutter_foreground": "#505970",
    "fold_marker": "#69738D",
    "brackets_foreground": "var(blue)",
    "brackets_options": "underline",
    "misspelling": "var(rose)",
    "accent": "var(blue)"
  },
  "rules": [
    {
      "name": "Comments",
      "scope": "comment.line.double-slash.c++, comment.block.c++, comment.line.double-slash.c++.joy, comment.block.c++.joy, comment.line.double-slash.c, comment.block.c",
      "foreground": "var(muted)",
      "font_style": "italic"
    },
    {
      "name": "Documentation",
      "scope": "comment.line.documentation.c++.joy, comment.block.documentation.c++.joy, comment.block.documentation.c",
      "foreground": "var(soft)"
    },
    {
      "name": "Comment delimiters",
      "scope": "punctuation.definition.comment.c++.joy, punctuation.definition.comment.end.c++.joy, punctuation.definition.comment.c, punctuation.definition.comment.documentation.c++.joy",
      "foreground": "#596278"
    },
    {
      "name": "Comment banners",
      "scope": "comment.block.banner.c++.joy, meta.toc-list.banner.block.c++.joy",
      "foreground": "var(lavender)",
      "font_style": "bold"
    },
    {
      "name": "Documentation commands",
      "scope": "keyword.other.documentation.c++.joy",
      "foreground": "var(cyan)",
      "font_style": "bold"
    },
    {
      "name": "Documentation sigils",
      "scope": "punctuation.definition.documentation.c++.joy",
      "foreground": "var(mauve)"
    },
    {
      "name": "Inline documentation code",
      "scope": "markup.raw.inline.documentation.c++.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "Critical markers",
      "scope": "markup.warning.critical.comment.c++.joy",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Warning markers",
      "scope": "markup.warning.comment.c++.joy",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Notice markers",
      "scope": "markup.note.comment.c++.joy",
      "foreground": "var(green)",
      "font_style": "bold"
    },
    {
      "name": "Links",
      "scope": "markup.underline.link.c++.joy",
      "foreground": "var(blue)",
      "font_style": "underline"
    },
    {
      "name": "Disabled preprocessor branches",
      "scope": "comment.block.preprocessor.c++, comment.block.preprocessor.c",
      "foreground": "var(muted)",
      "font_style": "italic"
    },
    {
      "name": "Preprocessor directives",
      "scope": "keyword.control.directive.c++, keyword.control.directive.c, keyword.control.directive.include.c++, keyword.control.directive.define.c++, keyword.control.directive.conditional.c++",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Preprocessor errors",
      "scope": "keyword.control.directive.error.c++, keyword.control.directive.error.c",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Macro definitions",
      "scope": "entity.name.function.preprocessor.c++, entity.name.constant.preprocessor.c++, entity.name.function.preprocessor.c, entity.name.constant.preprocessor.c",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Macro references",
      "scope": "constant.other.macro-reference.c++.joy, variable.function.assumed-macro.c++, variable.function.assumed-macro.c",
      "foreground": "var(pink)"
    },
    {
      "name": "Macro parameters",
      "scope": "variable.parameter.c++ meta.preprocessor, variable.parameter.c meta.preprocessor, variable.language.variadic.preprocessor.c++.joy",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Macro composition",
      "scope": "keyword.operator.token-paste.preprocessor.c++.joy, keyword.operator.stringification.preprocessor.c++.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Include paths",
      "scope": "string.quoted.double.include.c++, string.quoted.other.lt-gt.include.c++, string.quoted.double.include.c, string.quoted.other.lt-gt.include.c",
      "foreground": "var(green)"
    },
    {
      "name": "Control flow",
      "scope": "keyword.control.c++, keyword.control.conditional.c++, keyword.control.flow.break.c++, keyword.control.flow.continue.c++",
      "foreground": "var(rose)",
      "font_style": "bold"
    },
    {
      "name": "Return",
      "scope": "keyword.control.flow.return.c++.joy, keyword.control.flow.return.c++",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Exceptions",
      "scope": "keyword.control.exception.c++.joy, keyword.control.flow.throw.c++",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Coroutines",
      "scope": "keyword.control.coroutine.c++.joy",
      "foreground": "var(teal)",
      "font_style": "bold italic"
    },
    {
      "name": "Memory operators",
      "scope": "keyword.operator.memory.c++.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Casts",
      "scope": "keyword.operator.cast.c++.joy",
      "foreground": "var(lavender)",
      "font_style": "italic"
    },
    {
      "name": "Constraints",
      "scope": "keyword.operator.constraint.c++.joy, keyword.operator.word.c++ meta.constraint.c++",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Introspection",
      "scope": "keyword.operator.introspection.c++.joy",
      "foreground": "var(lavender)",
      "font_style": "italic"
    },
    {
      "name": "Module keywords",
      "scope": "meta.module.c++ keyword.control.c++, keyword.declaration.template.c++",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Module names",
      "scope": "entity.name.module.c++, entity.name.partition.c++, entity.name.partition.private",
      "foreground": "var(blue)",
      "font_style": "bold"
    },
    {
      "name": "Namespace definitions",
      "scope": "entity.name.namespace.c++",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Standard namespace",
      "scope": "entity.name.namespace.standard.c++.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Library namespaces",
      "scope": "entity.name.namespace.library.c++.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Namespace references",
      "scope": "entity.name.namespace.c++ punctuation.accessor.double-colon.c++",
      "foreground": "var(mauve)"
    },
    {
      "name": "Type declaration keywords",
      "scope": "keyword.declaration.type.c++.joy, keyword.declaration.class.c++, keyword.declaration.struct.c++, keyword.declaration.union.c++, keyword.declaration.enum.c++.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Concept keyword",
      "scope": "keyword.declaration.concept.c++.joy, keyword.declaration.concept.c++",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Concept definitions",
      "scope": "entity.name.concept.c++",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Class/struct/union names",
      "scope": "entity.name.class.c++, entity.name.struct.c++, entity.name.union.c++, entity.name.enum.c++, entity.name.type.typedef.c++, entity.name.type.using.c++",
      "foreground": "var(blue)",
      "font_style": "bold"
    },
    {
      "name": "Template parameters",
      "scope": "variable.parameter.template.c++.joy, variable.parameter.template.c++",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Template punctuation",
      "scope": "punctuation.definition.generic.c++",
      "foreground": "var(blue)"
    },
    {
      "name": "Constant evaluation",
      "scope": "storage.modifier.constant-evaluation.c++.joy",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "CV and mutability",
      "scope": "storage.modifier.cv.c++.joy",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Linkage/storage",
      "scope": "storage.modifier.linkage.c++.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Object model",
      "scope": "storage.modifier.object-model.c++.joy",
      "foreground": "var(pink)"
    },
    {
      "name": "Exception contracts",
      "scope": "storage.modifier.exception-contract.c++.joy",
      "foreground": "var(teal)",
      "font_style": "italic"
    },
    {
      "name": "Other modifiers",
      "scope": "storage.modifier.c++",
      "foreground": "var(lavender)"
    },
    {
      "name": "Scoped enum modifier",
      "scope": "storage.modifier.scoped-enum.c++.joy",
      "foreground": "var(lavender)",
      "font_style": "italic"
    },
    {
      "name": "Scalar integer types",
      "scope": "support.type.scalar.integer.c++.joy",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Scalar floating types",
      "scope": "support.type.scalar.floating.c++.joy",
      "foreground": "var(teal)",
      "font_style": "italic"
    },
    {
      "name": "Deduced/void types",
      "scope": "support.type.deduced-or-void.c++.joy",
      "foreground": "var(soft)",
      "font_style": "italic"
    },
    {
      "name": "Text types",
      "scope": "support.type.standard.text.c++.joy",
      "foreground": "var(green)"
    },
    {
      "name": "Container types",
      "scope": "support.type.standard.container.c++.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Ownership types",
      "scope": "support.type.standard.ownership.c++.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Sum/product types",
      "scope": "support.type.standard.sum.c++.joy",
      "foreground": "var(pink)"
    },
    {
      "name": "Callable types",
      "scope": "support.type.standard.callable.c++.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "Concurrency types",
      "scope": "support.type.standard.concurrency.c++.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Ranges types",
      "scope": "support.type.standard.ranges.c++.joy",
      "foreground": "var(green)"
    },
    {
      "name": "Error types",
      "scope": "support.type.standard.error.c++.joy",
      "foreground": "var(rose)"
    },
    {
      "name": "Time types",
      "scope": "support.type.standard.time.c++.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Numeric types",
      "scope": "support.type.standard.numeric.c++.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Standard concepts",
      "scope": "support.type.standard.concept.c++.joy",
      "foreground": "var(pink)"
    },
    {
      "name": "Fixed-width types",
      "scope": "support.type.standard.fixed-width.c++.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Other built-in types",
      "scope": "storage.type.c++, support.type.c++",
      "foreground": "var(blue)"
    },
    {
      "name": "Function definitions",
      "scope": "entity.name.function.c++",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Constructors",
      "scope": "entity.name.function.constructor.c++",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Destructors",
      "scope": "entity.name.function.destructor.c++",
      "foreground": "var(rose)",
      "font_style": "bold"
    },
    {
      "name": "Operator methods",
      "scope": "entity.name.function.operator.c++, variable.function.operator.c++",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Function calls",
      "scope": "variable.function.c++",
      "foreground": "var(green)"
    },
    {
      "name": "Member observer calls",
      "scope": "variable.function.member.observer.c++.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "Member mutator calls",
      "scope": "variable.function.member.mutator.c++.joy",
      "foreground": "var(peach)"
    },
    {
      "name": "Other member calls",
      "scope": "variable.function.member.c++",
      "foreground": "var(teal)"
    },
    {
      "name": "Memory functions",
      "scope": "support.function.memory.c++.joy",
      "foreground": "var(peach)"
    },
    {
      "name": "Algorithms",
      "scope": "support.function.algorithm.c++.joy",
      "foreground": "var(green)"
    },
    {
      "name": "Range functions",
      "scope": "support.function.range.c++.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "Utilities",
      "scope": "support.function.utility.c++.joy",
      "foreground": "var(gold)"
    },
    {
      "name": "I/O and formatting",
      "scope": "support.function.io.c++.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Standard I/O objects",
      "scope": "support.variable.standard.io.c++.joy",
      "foreground": "var(cyan)",
      "font_style": "bold"
    },
    {
      "name": "Concurrency functions",
      "scope": "support.function.concurrency.c++.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Numeric functions",
      "scope": "support.function.numeric.c++.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Time functions",
      "scope": "support.function.time.c++.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "This",
      "scope": "variable.language.this.c++.joy, variable.language.this.c++",
      "foreground": "var(rose)",
      "font_style": "italic"
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter.c++",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Member conventions",
      "scope": "variable.other.member.convention.c++.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Members",
      "scope": "variable.other.readwrite.member.c++, variable.other.member.c++",
      "foreground": "var(cyan)"
    },
    {
      "name": "Base classes",
      "scope": "variable.other.base-class.c++",
      "foreground": "var(blue)"
    },
    {
      "name": "Enum constants",
      "scope": "entity.name.constant.c++",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Null",
      "scope": "constant.language.null.c++.joy, constant.language.c++",
      "foreground": "var(soft)",
      "font_style": "italic"
    },
    {
      "name": "Booleans",
      "scope": "constant.language.boolean.c++.joy, constant.language.boolean.c++",
      "foreground": "var(rose)",
      "font_style": "italic"
    },
    {
      "name": "Standard constants",
      "scope": "support.constant.standard.c++.joy",
      "foreground": "var(gold)"
    },
    {
      "name": "Strings",
      "scope": "string.quoted.double.c++, string.quoted.double.c",
      "foreground": "var(green)"
    },
    {
      "name": "Raw strings",
      "scope": "string.quoted.double.c++ storage.type.string.c++",
      "foreground": "var(teal)"
    },
    {
      "name": "Characters",
      "scope": "string.quoted.single.c++, string.quoted.single.c",
      "foreground": "var(pink)"
    },
    {
      "name": "String delimiters",
      "scope": "punctuation.definition.string.c++, punctuation.definition.string.c",
      "foreground": "var(green)"
    },
    {
      "name": "Escapes",
      "scope": "constant.character.escape.c++, constant.character.escape.c",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Format placeholders",
      "scope": "constant.other.placeholder.c++, constant.other.placeholder.c",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric.value.c++",
      "foreground": "var(peach)"
    },
    {
      "name": "Numeric bases/suffixes",
      "scope": "constant.numeric.base.c++, constant.numeric.suffix.c++",
      "foreground": "var(blue)"
    },
    {
      "name": "Operators",
      "scope": "keyword.operator.c++, keyword.operator.arithmetic.c++, keyword.operator.comparison.c++, keyword.operator.logical.c++, keyword.operator.bitwise.c++",
      "foreground": "var(blue)"
    },
    {
      "name": "Assignment",
      "scope": "keyword.operator.assignment.c++",
      "foreground": "var(lavender)"
    },
    {
      "name": "Variadic operators",
      "scope": "keyword.operator.variadic.c++",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Attributes — intent",
      "scope": "storage.modifier.attribute.intent.c++.joy",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Attributes — low level",
      "scope": "storage.modifier.attribute.low-level.c++.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Other attributes",
      "scope": "meta.attribute.c++ storage.modifier.c++",
      "foreground": "var(pink)"
    },
    {
      "name": "Member access",
      "scope": "punctuation.accessor.dot.c++, punctuation.accessor.arrow.c++, punctuation.accessor.double-colon.c++.joy, punctuation.accessor.double-colon.c++",
      "foreground": "var(cyan)"
    },
    {
      "name": "Grouping punctuation",
      "scope": "punctuation.section.group.c++, punctuation.section.block.c++, punctuation.section.brackets.c++",
      "foreground": "var(soft)"
    },
    {
      "name": "Separators",
      "scope": "punctuation.separator.c++, punctuation.terminator.c++",
      "foreground": "var(muted)"
    },
    {
      "name": "Merge conflict begin/end",
      "scope": "meta.block.conflict.begin.diff, meta.block.conflict.end.diff",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Merge conflict separator",
      "scope": "meta.block.conflict.separator.diff",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Invalid source",
      "scope": "invalid.illegal",
      "foreground": "var(red)",
      "font_style": "stippled_underline"
    }
  ]
}
