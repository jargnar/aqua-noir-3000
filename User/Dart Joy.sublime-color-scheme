{
  "name": "Dart Joy",
  "variables": {
    "background": "#000000",
    "foreground": "#CDD6F4",
    "muted": "#737D96",
    "soft": "#939CB3",
    "rose": "#F38BA8",
    "peach": "#FAB387",
    "gold": "#F9C97C",
    "green": "#A6E3A1",
    "teal": "#94E2D5",
    "cyan": "#89DCEB",
    "blue": "#89B4FA",
    "lavender": "#B4BEFE",
    "mauve": "#CBA6F7",
    "pink": "#F5C2E7",
    "red": "#F26D78",
    "warning": "#F2CDCD"
  },
  "globals": {
    "background": "var(background)",
    "foreground": "var(foreground)",
    "caret": "#F5E0DC",
    "block_caret": "#F5E0DC",
    "selection": "#30364F",
    "selection_border": "#4A526E",
    "inactive_selection": "#252A3A",
    "inactive_selection_border": "#343A50",
    "line_highlight": "#151925",
    "find_highlight": "#F9C97C",
    "find_highlight_foreground": "#0F111A",
    "guide": "#22283A",
    "active_guide": "#4A526E",
    "stack_guide": "#343B52",
    "gutter": "var(background)",
    "gutter_foreground": "#505970",
    "fold_marker": "#69738D",
    "brackets_foreground": "var(blue)",
    "brackets_options": "underline",
    "misspelling": "var(rose)",
    "accent": "var(blue)"
  },
  "rules": [
    {
      "name": "Shebang",
      "scope": "comment.line.shebang.dart.joy",
      "foreground": "var(muted)",
      "font_style": "italic"
    },
    {
      "name": "Comments",
      "scope": "comment.line.double-slash.dart.joy, comment.block.dart.joy",
      "foreground": "var(muted)",
      "font_style": "italic"
    },
    {
      "name": "Documentation",
      "scope": "comment.line.documentation.dart.joy, comment.block.documentation.dart.joy",
      "foreground": "var(soft)"
    },
    {
      "name": "Comment delimiters",
      "scope": "punctuation.definition.comment.dart.joy, punctuation.definition.comment.begin.dart.joy, punctuation.definition.comment.end.dart.joy, punctuation.definition.comment.documentation.dart.joy",
      "foreground": "#596278"
    },
    {
      "name": "Dartdoc references",
      "scope": "markup.underline.link.reference.documentation.dart.joy, markup.raw.inline.documentation.dart.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Dartdoc headings",
      "scope": "markup.heading.documentation.dart.joy",
      "foreground": "var(lavender)",
      "font_style": "bold"
    },
    {
      "name": "Dartdoc emphasis",
      "scope": "markup.bold.documentation.dart.joy",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Links",
      "scope": "markup.underline.link.dart.joy",
      "foreground": "var(blue)",
      "font_style": "underline"
    },
    {
      "name": "Critical markers",
      "scope": "markup.warning.critical.comment.dart.joy",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Warning markers",
      "scope": "markup.warning.comment.dart.joy",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Notice markers",
      "scope": "markup.note.comment.dart.joy",
      "foreground": "var(green)",
      "font_style": "bold"
    },
    {
      "name": "Directives",
      "scope": "keyword.control.directive.dart.joy, keyword.control.directive.combinator.dart.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Directive aliases",
      "scope": "keyword.other.alias.dart.joy, storage.modifier.deferred.dart.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Library names",
      "scope": "entity.name.namespace.alias.dart.joy, entity.name.reference.directive.dart.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Control flow",
      "scope": "keyword.control.dart.joy, keyword.control.conditional.dart.joy, keyword.control.pattern.dart.joy, keyword.control.pattern.guard.dart.joy",
      "foreground": "var(rose)",
      "font_style": "bold"
    },
    {
      "name": "Return",
      "scope": "keyword.control.flow.return.dart.joy",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Exceptions",
      "scope": "keyword.control.exception.dart.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Async flow",
      "scope": "keyword.control.async.dart.joy",
      "foreground": "var(teal)",
      "font_style": "bold italic"
    },
    {
      "name": "Assertions",
      "scope": "keyword.control.assert.dart.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Declaration keywords",
      "scope": "keyword.declaration.class.dart.joy, keyword.declaration.mixin.dart.joy, keyword.declaration.enum.dart.joy, keyword.declaration.extension.dart.joy, keyword.declaration.type.dart.joy, keyword.declaration.typedef.dart.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Inheritance",
      "scope": "keyword.declaration.inheritance.dart.joy",
      "foreground": "var(lavender)",
      "font_style": "italic"
    },
    {
      "name": "Class modifiers",
      "scope": "storage.modifier.class.dart.joy, storage.modifier.augmentation.dart.joy",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Declaration modifiers",
      "scope": "storage.modifier.declaration.dart.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Variable modifiers",
      "scope": "storage.modifier.variable.dart.joy, storage.modifier.final.dart.joy, storage.modifier.late.dart.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Constants modifier",
      "scope": "storage.modifier.constant.dart.joy",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Pattern modifier",
      "scope": "storage.modifier.pattern.dart.joy",
      "foreground": "var(mauve)"
    },
    {
      "name": "Parameter modifiers",
      "scope": "storage.modifier.parameter.dart.joy",
      "foreground": "var(peach)",
      "font_style": "italic"
    },
    {
      "name": "Constructor modifiers",
      "scope": "storage.modifier.constructor.dart.joy",
      "foreground": "var(peach)"
    },
    {
      "name": "Accessor/operator intent",
      "scope": "storage.type.accessor.dart.joy, storage.type.operator.dart.joy",
      "foreground": "var(teal)",
      "font_style": "italic"
    },
    {
      "name": "Annotation sigil",
      "scope": "punctuation.definition.annotation.dart.joy",
      "foreground": "#D48BE8"
    },
    {
      "name": "Core annotations",
      "scope": "storage.modifier.annotation.core.dart.joy",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Analyzer annotations",
      "scope": "storage.modifier.annotation.analyzer.dart.joy",
      "foreground": "var(mauve)"
    },
    {
      "name": "Custom annotations",
      "scope": "entity.other.attribute-name.annotation.dart.joy",
      "foreground": "var(pink)"
    },
    {
      "name": "Type declarations",
      "scope": "entity.name.type.class.dart.joy, entity.name.type.mixin.dart.joy, entity.name.type.enum.dart.joy, entity.name.type.extension.dart.joy, entity.name.type.typedef.dart.joy",
      "foreground": "var(blue)",
      "font_style": "bold"
    },
    {
      "name": "Return and variable type positions",
      "scope": "storage.type.return.dart.joy, storage.type.variable.dart.joy, storage.type.parameter.dart.joy, storage.type.pattern.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Scalar types",
      "scope": "support.type.scalar.dart.joy",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Top types",
      "scope": "support.type.top.dart.joy",
      "foreground": "var(soft)",
      "font_style": "italic"
    },
    {
      "name": "Text types",
      "scope": "support.type.text.dart.joy",
      "foreground": "var(green)"
    },
    {
      "name": "Collection types",
      "scope": "support.type.collection.dart.joy",
      "foreground": "var(lavender)"
    },
    {
      "name": "Async types",
      "scope": "support.type.async.dart.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "Core types",
      "scope": "support.type.core.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Error types",
      "scope": "support.type.error.dart.joy",
      "foreground": "var(rose)"
    },
    {
      "name": "User types",
      "scope": "support.class.user.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Function declarations",
      "scope": "entity.name.function.dart.joy",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Getter/setter declarations",
      "scope": "entity.name.function.getter.dart.joy, entity.name.function.setter.dart.joy",
      "foreground": "var(teal)",
      "font_style": "bold"
    },
    {
      "name": "Operator declarations",
      "scope": "entity.name.function.operator.dart.joy",
      "foreground": "var(pink)",
      "font_style": "bold"
    },
    {
      "name": "Constructor declarations",
      "scope": "entity.name.function.constructor.dart.joy, entity.name.function.constructor.named.dart.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Direct calls",
      "scope": "variable.function.dart.joy",
      "foreground": "var(green)"
    },
    {
      "name": "Private calls",
      "scope": "variable.function.private.dart.joy",
      "foreground": "var(gold)",
      "font_style": "italic"
    },
    {
      "name": "Member calls",
      "scope": "variable.function.member.dart.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "Named constructors",
      "scope": "variable.function.constructor.named.dart.joy",
      "foreground": "var(peach)"
    },
    {
      "name": "Dot shorthand calls",
      "scope": "variable.function.dot-shorthand.dart.joy",
      "foreground": "var(pink)"
    },
    {
      "name": "Core functions",
      "scope": "support.function.core.dart.joy",
      "foreground": "var(cyan)",
      "font_style": "bold"
    },
    {
      "name": "Variable declarations",
      "scope": "variable.other.declaration.dart.joy",
      "foreground": "var(lavender)",
      "font_style": "bold"
    },
    {
      "name": "Constant declarations",
      "scope": "entity.name.constant.dart.joy, entity.name.constant.enum.dart.joy",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Parameters",
      "scope": "variable.parameter.dart.joy, variable.parameter.field-formal.dart.joy",
      "foreground": "var(cyan)",
      "font_style": "italic"
    },
    {
      "name": "Lambda parameters",
      "scope": "meta.function.parameters.lambda.dart.joy variable.parameter.dart.joy",
      "foreground": "var(teal)",
      "font_style": "italic"
    },
    {
      "name": "Named arguments",
      "scope": "variable.parameter.label.dart.joy",
      "foreground": "var(pink)",
      "font_style": "italic"
    },
    {
      "name": "Pattern bindings",
      "scope": "variable.other.binding.pattern.dart.joy",
      "foreground": "var(lavender)",
      "font_style": "bold"
    },
    {
      "name": "Private variables",
      "scope": "variable.other.private.dart.joy, variable.other.member.private.dart.joy",
      "foreground": "var(soft)",
      "font_style": "italic"
    },
    {
      "name": "Members",
      "scope": "variable.other.member.dart.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Ordinary variables",
      "scope": "variable.other.readwrite.dart.joy",
      "foreground": "var(foreground)"
    },
    {
      "name": "Language variables",
      "scope": "variable.language.dart.joy",
      "foreground": "var(rose)",
      "font_style": "italic"
    },
    {
      "name": "Wildcards",
      "scope": "variable.language.wildcard.dart.joy",
      "foreground": "var(muted)",
      "font_style": "italic"
    },
    {
      "name": "Labels",
      "scope": "entity.name.label.dart.joy",
      "foreground": "var(lavender)",
      "font_style": "bold"
    },
    {
      "name": "Namespace prefixes",
      "scope": "entity.name.namespace.prefix.dart.joy",
      "foreground": "var(mauve)"
    },
    {
      "name": "Strings",
      "scope": "string.quoted.double.dart.joy, string.quoted.single.dart.joy, string.quoted.triple.double.dart.joy, string.quoted.triple.single.dart.joy",
      "foreground": "var(green)"
    },
    {
      "name": "Raw strings",
      "scope": "string.quoted.double.raw.dart.joy, string.quoted.single.raw.dart.joy, string.quoted.triple.double.raw.dart.joy, string.quoted.triple.single.raw.dart.joy",
      "foreground": "var(teal)"
    },
    {
      "name": "String delimiters",
      "scope": "punctuation.definition.string.begin.dart.joy, punctuation.definition.string.end.dart.joy",
      "foreground": "#78B58D"
    },
    {
      "name": "Interpolation punctuation",
      "scope": "punctuation.definition.interpolation.dart.joy, punctuation.section.interpolation.begin.dart.joy, punctuation.section.interpolation.end.dart.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Interpolation variables",
      "scope": "variable.other.interpolation.dart.joy",
      "foreground": "var(cyan)",
      "font_style": "bold"
    },
    {
      "name": "Escapes",
      "scope": "constant.character.escape.dart.joy",
      "foreground": "var(peach)",
      "font_style": "bold"
    },
    {
      "name": "Numbers",
      "scope": "constant.numeric.value.dart.joy",
      "foreground": "var(peach)"
    },
    {
      "name": "Numeric bases",
      "scope": "constant.numeric.base.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Booleans",
      "scope": "constant.language.boolean.dart.joy",
      "foreground": "var(rose)",
      "font_style": "italic"
    },
    {
      "name": "Null",
      "scope": "constant.language.null.dart.joy",
      "foreground": "var(soft)",
      "font_style": "italic"
    },
    {
      "name": "Dot shorthand constants",
      "scope": "constant.other.dot-shorthand.dart.joy",
      "foreground": "var(pink)"
    },
    {
      "name": "Null-safety operators",
      "scope": "keyword.operator.null-coalescing.dart.joy, keyword.operator.null-aware-access.dart.joy, keyword.operator.null-assertion.dart.joy, keyword.operator.nullable.type.dart.joy",
      "foreground": "var(cyan)",
      "font_style": "bold"
    },
    {
      "name": "Spread/rest",
      "scope": "keyword.operator.spread.dart.joy, keyword.operator.rest.pattern.dart.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Arrow",
      "scope": "keyword.operator.arrow.dart.joy",
      "foreground": "var(mauve)",
      "font_style": "bold"
    },
    {
      "name": "Type operators",
      "scope": "keyword.operator.type.dart.joy, keyword.operator.creation.dart.joy",
      "foreground": "var(lavender)",
      "font_style": "italic"
    },
    {
      "name": "Assignment",
      "scope": "keyword.operator.assignment.dart.joy, keyword.operator.assignment.default.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Comparison/logical",
      "scope": "keyword.operator.comparison.dart.joy, keyword.operator.logical.dart.joy, keyword.operator.ternary.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Arithmetic/bitwise",
      "scope": "keyword.operator.arithmetic.dart.joy, keyword.operator.bitwise.dart.joy, keyword.operator.increment-decrement.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Member access",
      "scope": "punctuation.accessor.member.dart.joy, punctuation.accessor.dot-shorthand.dart.joy",
      "foreground": "var(cyan)"
    },
    {
      "name": "Other access",
      "scope": "punctuation.accessor.dot.dart.joy",
      "foreground": "var(blue)"
    },
    {
      "name": "Group punctuation",
      "scope": "punctuation.section.group, punctuation.section.brackets, punctuation.section.braces, punctuation.section.record, punctuation.section.parameters, punctuation.section.block",
      "foreground": "var(soft)"
    },
    {
      "name": "Separators",
      "scope": "punctuation.separator.sequence.dart.joy, punctuation.separator.parameters.dart.joy, punctuation.separator.key-value.dart.joy, punctuation.separator.case.dart.joy, punctuation.separator.label.dart.joy, punctuation.terminator.statement.dart.joy, punctuation.terminator.enum-values.dart.joy",
      "foreground": "var(muted)"
    },
    {
      "name": "Merge conflict begin/end",
      "scope": "meta.block.conflict.begin.diff, meta.block.conflict.end.diff",
      "foreground": "var(red)",
      "font_style": "bold"
    },
    {
      "name": "Merge conflict separator",
      "scope": "meta.block.conflict.separator.diff",
      "foreground": "var(gold)",
      "font_style": "bold"
    },
    {
      "name": "Invalid source",
      "scope": "invalid.illegal",
      "foreground": "var(red)",
      "font_style": "stippled_underline"
    }
  ]
}
