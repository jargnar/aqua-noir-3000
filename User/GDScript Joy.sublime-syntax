%YAML 1.2
---
name: GDScript Joy
scope: source.gdscript
version: 2
file_extensions:
  - gd

# A semantic, standalone GDScript 4.x syntax for Sublime Text 4.
# The syntax deliberately separates declaration sites, references, calls,
# types, node paths, StringNames, callbacks, annotations and literal kinds.

variables:
  identifier_start: '[\p{L}\p{Nl}_]'
  identifier_continue: '[\p{L}\p{Nl}\p{Mn}\p{Mc}\p{Nd}\p{Pc}_]'
  identifier: '{{identifier_start}}{{identifier_continue}}*'
  word_start: '(?<!{{identifier_continue}})'
  word_end: '(?!{{identifier_continue}})'

  primitive_types: '(?:bool|int|float|String|StringName|NodePath|Variant|void)'
  math_types: '(?:Vector2|Vector2i|Rect2|Rect2i|Vector3|Vector3i|Transform2D|Vector4|Vector4i|Plane|Quaternion|AABB|Basis|Transform3D|Projection|Color)'
  collection_types: '(?:Dictionary|Array|PackedByteArray|PackedInt32Array|PackedInt64Array|PackedFloat32Array|PackedFloat64Array|PackedStringArray|PackedVector2Array|PackedVector3Array|PackedColorArray|PackedVector4Array)'
  core_types: '(?:RID|Object|Callable|Signal)'
  acronym_classes: '(?:JSON|UPNP)'

  annotation_export: '(?:export|export_category|export_color_no_alpha|export_custom|export_dir|export_enum|export_exp_easing|export_file|export_file_path|export_flags|export_flags_2d_navigation|export_flags_2d_physics|export_flags_2d_render|export_flags_3d_navigation|export_flags_3d_physics|export_flags_3d_render|export_flags_avoidance|export_global_dir|export_global_file|export_group|export_multiline|export_node_path|export_placeholder|export_range|export_storage|export_subgroup|export_tool_button)'
  annotation_execution: '(?:abstract|icon|onready|static_unload|tool)'
  annotation_network: '(?:rpc)'
  annotation_warning: '(?:warning_ignore|warning_ignore_restore|warning_ignore_start)'

  builtin_math_functions: '(?:abs|absf|absi|acos|acosh|angle_difference|asin|asinh|atan|atan2|atanh|bezier_derivative|bezier_interpolate|ceil|ceilf|ceili|clamp|clampf|clampi|cos|cosh|cubic_interpolate|cubic_interpolate_angle|cubic_interpolate_angle_in_time|cubic_interpolate_in_time|db_to_linear|deg_to_rad|ease|exp|floor|floorf|floori|fmod|fposmod|inverse_lerp|is_equal_approx|is_finite|is_inf|is_nan|is_zero_approx|lerp|lerp_angle|lerpf|linear_to_db|log|max|maxf|maxi|min|minf|mini|move_toward|nearest_po2|pingpong|posmod|pow|rad_to_deg|remap|rotate_toward|round|roundf|roundi|sign|signf|signi|sin|sinh|smoothstep|snapped|snappedf|snappedi|sqrt|step_decimals|tan|tanh|wrap|wrapf|wrapi)'
  builtin_random_functions: '(?:rand_from_seed|randf|randf_range|randfn|randi|randi_range|randomize|seed)'
  builtin_conversion_functions: '(?:bytes_to_var|bytes_to_var_with_objects|char|hash|ord|str|str_to_var|type_convert|type_string|typeof|var_to_bytes|var_to_bytes_with_objects|var_to_str|weakref)'
  builtin_runtime_functions: '(?:error_string|get_stack|instance_from_id|is_instance_id_valid|is_instance_of|is_instance_valid|is_same|len|range|rid_allocate_id|rid_from_int64)'
  builtin_resource_functions: '(?:load)'
  builtin_output_functions: '(?:print|print_debug|print_rich|print_stack|print_verbose|printerr|printraw|prints|printt|push_error|push_warning)'
  deprecated_builtin_functions: '(?:Color8|convert|dict_to_inst|inst_to_dict|type_exists)'

  engine_singletons: '(?:AccessibilityServer|AudioServer|CameraServer|ClassDB|DisplayServer|EditorInterface|Engine|EngineDebugger|GDExtensionManager|GDScriptLanguageProtocol|Geometry2D|Geometry3D|IP|Input|InputMap|JavaClassWrapper|JavaScriptBridge|Marshalls|NativeMenu|NavigationMeshGenerator|NavigationServer2D|NavigationServer2DManager|NavigationServer3D|NavigationServer3DManager|OS|Performance|PhysicsServer2D|PhysicsServer2DManager|PhysicsServer3D|PhysicsServer3DManager|ProjectSettings|RenderingServer|ResourceLoader|ResourceSaver|ResourceUID|TextServerManager|ThemeDB|Time|TranslationServer|WorkerThreadPool|XRServer)'

  lifecycle_callbacks: '(?:_init|_static_init|_ready|_process|_physics_process|_input|_shortcut_input|_unhandled_input|_unhandled_key_input|_gui_input|_draw|_notification|_enter_tree|_exit_tree|_get|_set|_get_property_list|_property_can_revert|_property_get_revert|_validate_property|_to_string|_get_configuration_warnings|_make_custom_tooltip|_physics_interpolation_changed|_reset_state|_integrate_forces|_input_event)'

  critical_marker: '(?:ALERT|ATTENTION|CAUTION|CRITICAL|DANGER|SECURITY)'
  warning_marker: '(?:BUG|DEPRECATED|FIXME|HACK|TASK|TBD|TODO|WARNING)'
  notice_marker: '(?:INFO|NOTE|NOTICE|TEST|TESTING)'

contexts:
  prototype:
    - include: merge-conflict-markers
    - include: comments

  main:
    - include: declarations
    - include: expressions

  # -----------------------------------------------------------------------
  # Structural declarations
  # -----------------------------------------------------------------------

  declarations:
    - include: annotations

    - match: '{{word_start}}(class_name){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.modifier.class-name.gdscript
        2: entity.name.type.class.global.gdscript

    - match: '{{word_start}}(extends){{word_end}}'
      captures:
        1: storage.modifier.extends.gdscript
      push: extends-tail

    - match: '{{word_start}}(class){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.type.class.gdscript
        2: entity.name.type.class.local.gdscript
      push: class-declaration-tail

    # Named functions: lifecycle callbacks, private functions, then ordinary functions.
    - match: '{{word_start}}(func){{word_end}}[ \t]+({{lifecycle_callbacks}})[ \t]*(\()'
      captures:
        1: storage.type.function.gdscript
        2: entity.name.function.lifecycle.gdscript
        3: punctuation.section.parameters.begin.gdscript
      push: function-parameters

    - match: '{{word_start}}(func){{word_end}}[ \t]+(_{{identifier_continue}}*)[ \t]*(\()'
      captures:
        1: storage.type.function.gdscript
        2: entity.name.function.private.gdscript
        3: punctuation.section.parameters.begin.gdscript
      push: function-parameters

    - match: '{{word_start}}(func){{word_end}}[ \t]+({{identifier}})[ \t]*(\()'
      captures:
        1: storage.type.function.gdscript
        2: entity.name.function.gdscript
        3: punctuation.section.parameters.begin.gdscript
      push: function-parameters

    # Signals are declarations, not ordinary functions.
    - match: '{{word_start}}(signal){{word_end}}[ \t]+({{identifier}})[ \t]*(\()'
      captures:
        1: storage.type.signal.gdscript
        2: entity.name.function.signal.gdscript
        3: punctuation.section.parameters.begin.gdscript
      push: signal-parameters

    - match: '{{word_start}}(signal){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.type.signal.gdscript
        2: entity.name.function.signal.gdscript

    # Enum names and enum members receive their own scopes.
    - match: '{{word_start}}(enum){{word_end}}[ \t]+({{identifier}})[ \t]*(\{)'
      captures:
        1: storage.type.enum.gdscript
        2: entity.name.type.enum.gdscript
        3: punctuation.section.braces.begin.gdscript
      push: enum-member

    - match: '{{word_start}}(enum){{word_end}}[ \t]*(\{)'
      captures:
        1: storage.type.enum.gdscript
        2: punctuation.section.braces.begin.gdscript
      push: enum-member

    - match: '{{word_start}}(enum){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.type.enum.gdscript
        2: entity.name.type.enum.gdscript
      push: enum-before-body

    # Constants and variables use distinct declaration scopes.
    - match: '{{word_start}}(const){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.type.constant.gdscript
        2: entity.name.constant.gdscript
      push: variable-declaration-tail

    - match: '{{word_start}}(var){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.type.variable.gdscript
        2: variable.other.declaration.gdscript
      push: variable-declaration-tail

    # The loop target is a binding site, not an ordinary reference.
    - match: '{{word_start}}(for){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: keyword.control.loop.gdscript
        2: variable.other.binding.loop.gdscript
      push: for-declaration-tail

    # Contextual property accessors. `get` and `set` are intentionally not
    # colored as keywords everywhere because they remain legal identifiers.
    # The full-line form handles accessors delegated to existing functions.
    - match: '^(\s*)(get|set)([ \t]*)(=)([ \t]*)({{identifier}})(?:([ \t]*)(,)([ \t]*)(get|set)([ \t]*)(=)([ \t]*)({{identifier}}))?'
      captures:
        2: entity.name.function.accessor.gdscript
        4: keyword.operator.assignment.accessor.gdscript
        6: variable.function.accessor.gdscript
        8: punctuation.separator.accessors.gdscript
        10: entity.name.function.accessor.gdscript
        12: keyword.operator.assignment.accessor.gdscript
        14: variable.function.accessor.gdscript

    - match: '^(\s*)(get|set){{word_end}}(?=[ \t]*=)'
      captures:
        2: entity.name.function.accessor.gdscript

    - match: '^(\s*)(get)([ \t]*)(:)'
      captures:
        2: entity.name.function.accessor.gdscript
        4: punctuation.section.accessor.gdscript

    - match: '^(\s*)(set)([ \t]*)(\()'
      captures:
        2: entity.name.function.accessor.gdscript
        4: punctuation.section.parameters.begin.gdscript
      push: accessor-parameters

    - match: '^(\s*)(set)([ \t]*)(:)'
      captures:
        2: entity.name.function.accessor.gdscript
        4: punctuation.section.accessor.gdscript

  annotations:
    - match: '(@)({{annotation_export}}){{word_end}}'
      captures:
        1: punctuation.definition.annotation.gdscript
        2: storage.modifier.annotation.export.gdscript

    - match: '(@)({{annotation_execution}}){{word_end}}'
      captures:
        1: punctuation.definition.annotation.gdscript
        2: storage.modifier.annotation.execution.gdscript

    - match: '(@)({{annotation_network}}){{word_end}}'
      captures:
        1: punctuation.definition.annotation.gdscript
        2: storage.modifier.annotation.network.gdscript

    - match: '(@)({{annotation_warning}}){{word_end}}'
      captures:
        1: punctuation.definition.annotation.gdscript
        2: storage.modifier.annotation.warning.gdscript

    # Kept non-invalid for forward compatibility with future Godot releases.
    - match: '(@)({{identifier}})'
      captures:
        1: punctuation.definition.annotation.gdscript
        2: entity.other.attribute-name.annotation.unknown.gdscript

  extends-tail:
    - meta_scope: meta.declaration.extends.gdscript
    - match: '(?=\r?$)'
      pop: true
    - include: strings
    - include: type-atoms
    - match: ','
      scope: punctuation.separator.sequence.gdscript

  class-declaration-tail:
    - meta_scope: meta.declaration.class.gdscript
    - match: ':'
      scope: punctuation.section.class.gdscript
      pop: true
    - match: '{{word_start}}extends{{word_end}}'
      scope: storage.modifier.extends.gdscript
    - match: '(?=\r?$)'
      pop: true
    - include: strings
    - include: type-atoms

  # -----------------------------------------------------------------------
  # Function, signal and accessor signatures
  # -----------------------------------------------------------------------

  function-parameters:
    - meta_scope: meta.function.parameters.gdscript
    - match: '\)'
      scope: punctuation.section.parameters.end.gdscript
      set: function-after-parameters
    - match: '(\.\.\.)[ \t]*({{identifier}})'
      captures:
        1: keyword.operator.variadic.gdscript
        2: variable.parameter.variadic.gdscript
    - match: '{{identifier}}'
      scope: variable.parameter.gdscript
    - match: ':'
      scope: punctuation.separator.type.gdscript
      push: parameter-type
    - match: '='
      scope: keyword.operator.assignment.default.gdscript
      push: parameter-default
    - match: ','
      scope: punctuation.separator.parameters.gdscript
    - include: groups

  signal-parameters:
    - meta_scope: meta.signal.parameters.gdscript
    - match: '\)'
      scope: punctuation.section.parameters.end.gdscript
      pop: true
    - match: '(\.\.\.)[ \t]*({{identifier}})'
      captures:
        1: keyword.operator.variadic.gdscript
        2: variable.parameter.variadic.gdscript
    - match: '{{identifier}}'
      scope: variable.parameter.gdscript
    - match: ':'
      scope: punctuation.separator.type.gdscript
      push: parameter-type
    - match: '='
      scope: keyword.operator.assignment.default.gdscript
      push: parameter-default
    - match: ','
      scope: punctuation.separator.parameters.gdscript
    - include: groups

  accessor-parameters:
    - meta_scope: meta.accessor.parameters.gdscript
    - match: '\)'
      scope: punctuation.section.parameters.end.gdscript
      set: accessor-after-parameters
    - match: '{{identifier}}'
      scope: variable.parameter.accessor.gdscript
    - match: ':'
      scope: punctuation.separator.type.gdscript
      push: parameter-type
    - match: ','
      scope: punctuation.separator.parameters.gdscript

  parameter-type:
    - meta_scope: meta.type.annotation.parameter.gdscript
    - match: '='
      scope: keyword.operator.assignment.default.gdscript
      set: parameter-default
    - match: '(?=[,)])'
      pop: true
    - include: type-atoms

  parameter-default:
    - meta_scope: meta.function.parameter.default.gdscript
    - match: '(?=[,)])'
      pop: true
    - include: expressions

  function-after-parameters:
    - meta_scope: meta.function.signature.gdscript
    - match: '->'
      scope: punctuation.separator.return-type.gdscript
      set: function-return-type
    - match: ':'
      scope: punctuation.section.function.gdscript
      pop: true
    - match: ';'
      scope: punctuation.terminator.statement.gdscript
      pop: true
    - match: '(?=\r?$)'
      pop: true

  function-return-type:
    - meta_scope: meta.type.return.gdscript
    - match: ':'
      scope: punctuation.section.function.gdscript
      pop: true
    - match: ';'
      scope: punctuation.terminator.statement.gdscript
      pop: true
    - match: '(?=\r?$)'
      pop: true
    - include: type-atoms

  accessor-after-parameters:
    - meta_scope: meta.accessor.signature.gdscript
    - match: ':'
      scope: punctuation.section.accessor.gdscript
      pop: true
    - match: '(?=\r?$)'
      pop: true

  # -----------------------------------------------------------------------
  # Variable declarations, loop bindings and enum bodies
  # -----------------------------------------------------------------------

  variable-declaration-tail:
    - meta_scope: meta.declaration.variable.gdscript
    - match: ':='
      scope: keyword.operator.assignment.inferred.gdscript
      set: variable-initializer
    - match: ':(?=[ \t]*(?:get|set){{word_end}}[ \t]*=)'
      scope: punctuation.section.accessor.gdscript
      set: property-inline-accessors
    - match: ':(?=[ \t]*(?:#.*)?\r?$)'
      scope: punctuation.section.accessor.gdscript
      pop: true
    - match: ':'
      scope: punctuation.separator.type.gdscript
      set: variable-type
    - match: '='
      scope: keyword.operator.assignment.gdscript
      set: variable-initializer
    - match: '(?=[,\]\})])'
      pop: true
    - match: '(?=\r?$)'
      pop: true

  variable-type:
    - meta_scope: meta.type.annotation.variable.gdscript
    - match: '='
      scope: keyword.operator.assignment.gdscript
      set: variable-initializer
    - match: ':(?=[ \t]*(?:get|set){{word_end}}[ \t]*=)'
      scope: punctuation.section.accessor.gdscript
      set: property-inline-accessors
    - match: ':'
      scope: punctuation.section.accessor.gdscript
      pop: true
    - match: '(?=[,\]\})])'
      pop: true
    - match: '(?=\r?$)'
      pop: true
    - include: type-atoms

  variable-initializer:
    - meta_scope: meta.declaration.initializer.gdscript
    - match: '\\[ \t]*\r?\n'
      scope: punctuation.separator.continuation.line.gdscript
    - match: ':(?=[ \t]*(?:get|set){{word_end}}[ \t]*=)'
      scope: punctuation.section.accessor.gdscript
      set: property-inline-accessors
    - match: ':(?=[ \t]*(?:#.*)?\r?$)'
      scope: punctuation.section.accessor.gdscript
    - match: '\r?\n'
      pop: true
    - match: '(?=[\]\}])'
      pop: true
    - include: expressions

  property-inline-accessors:
    - meta_scope: meta.property.accessors.inline.gdscript
    - match: '(?=\r?$)'
      pop: true
    - match: '{{word_start}}(get|set){{word_end}}([ \t]*)(=)([ \t]*)({{identifier}})'
      captures:
        1: entity.name.function.accessor.gdscript
        3: keyword.operator.assignment.accessor.gdscript
        5: variable.function.accessor.gdscript
    - match: '{{word_start}}(?:get|set){{word_end}}(?=[ \t]*=)'
      scope: entity.name.function.accessor.gdscript
    - match: '='
      scope: keyword.operator.assignment.accessor.gdscript
    - match: ','
      scope: punctuation.separator.accessors.gdscript
    - include: expressions

  for-declaration-tail:
    - meta_scope: meta.for.binding.gdscript
    - match: ':'
      scope: punctuation.separator.type.gdscript
      set: for-binding-type
    - match: '{{word_start}}in{{word_end}}'
      scope: keyword.operator.word.membership.gdscript
      set: for-iterable
    - match: '(?=\r?$)'
      pop: true

  for-binding-type:
    - meta_scope: meta.type.annotation.loop-binding.gdscript
    - match: '{{word_start}}in{{word_end}}'
      scope: keyword.operator.word.membership.gdscript
      set: for-iterable
    - match: '(?=\r?$)'
      pop: true
    - include: type-atoms

  for-iterable:
    - meta_scope: meta.for.iterable.gdscript
    - match: ':'
      scope: punctuation.section.loop.gdscript
      pop: true
    - match: '\\[ \t]*\r?\n'
      scope: punctuation.separator.continuation.line.gdscript
    - match: '(?=\r?$)'
      pop: true
    - include: expressions

  enum-before-body:
    - meta_scope: meta.declaration.enum.gdscript
    - match: '\{'
      scope: punctuation.section.braces.begin.gdscript
      set: enum-member
    - match: '(?=\r?$)'
      pop: true

  enum-member:
    - meta_scope: meta.enum.gdscript
    - match: '\}'
      scope: punctuation.section.braces.end.gdscript
      pop: true
    - match: ','
      scope: punctuation.separator.sequence.gdscript
    - match: '{{identifier}}'
      scope: variable.other.constant.enum.gdscript
      set: enum-member-tail

  enum-member-tail:
    - meta_scope: meta.enum.gdscript
    - match: '='
      scope: keyword.operator.assignment.gdscript
      set: enum-member-value
    - match: ','
      scope: punctuation.separator.sequence.gdscript
      set: enum-member
    - match: '\}'
      scope: punctuation.section.braces.end.gdscript
      pop: true

  enum-member-value:
    - meta_scope: meta.enum.gdscript
    - match: ','
      scope: punctuation.separator.sequence.gdscript
      set: enum-member
    - match: '\}'
      scope: punctuation.section.braces.end.gdscript
      pop: true
    - include: expressions

  # -----------------------------------------------------------------------
  # Expressions and contextual language elements
  # -----------------------------------------------------------------------

  expressions:
    - include: lambdas
    - include: match-bindings
    - include: strings
    - include: node-shorthands
    - include: numbers
    - include: literals
    - include: keywords
    - include: builtin-symbols
    - include: member-access
    - include: groups
    - include: operators
    - include: identifiers
    - include: punctuation
    - include: invalid-source

  lambdas:
    - match: '{{word_start}}(func){{word_end}}[ \t]+({{identifier}})[ \t]*(\()'
      captures:
        1: storage.type.function.lambda.gdscript
        2: entity.name.function.lambda.gdscript
        3: punctuation.section.parameters.begin.gdscript
      push: function-parameters

    - match: '{{word_start}}(func){{word_end}}[ \t]*(\()'
      captures:
        1: storage.type.function.lambda.gdscript
        2: punctuation.section.parameters.begin.gdscript
      push: function-parameters

  match-bindings:
    - match: '{{word_start}}(var){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: keyword.other.binding.pattern.gdscript
        2: variable.other.binding.pattern.gdscript

  keywords:
    - match: '{{word_start}}(?:if|elif|else){{word_end}}'
      scope: keyword.control.conditional.gdscript
    - match: '{{word_start}}(?:for|while){{word_end}}'
      scope: keyword.control.loop.gdscript
    - match: '{{word_start}}(?:match|when){{word_end}}'
      scope: keyword.control.match.gdscript
    - match: '{{word_start}}(?:break|continue|pass|return){{word_end}}'
      scope: keyword.control.flow.gdscript
    - match: '{{word_start}}await{{word_end}}'
      scope: keyword.control.flow.async.gdscript
    - match: '{{word_start}}yield{{word_end}}'
      scope: invalid.deprecated.keyword.gdscript
    - match: '{{word_start}}breakpoint{{word_end}}'
      scope: keyword.other.debug.gdscript
    - match: '{{word_start}}assert{{word_end}}'
      scope: keyword.other.assert.gdscript
    - match: '{{word_start}}preload{{word_end}}'
      scope: keyword.other.preload.gdscript
    - match: '{{word_start}}(?:and|or|not){{word_end}}'
      scope: keyword.operator.word.logical.gdscript
    - match: '{{word_start}}(?:in|is|as){{word_end}}'
      scope: keyword.operator.word.type.gdscript
    - match: '{{word_start}}static{{word_end}}'
      scope: storage.modifier.static.gdscript
    - match: '{{word_start}}(?:self|super){{word_end}}'
      scope: variable.language.gdscript
    - match: '{{word_start}}(?:namespace|trait){{word_end}}'
      scope: keyword.reserved.future.gdscript
    - match: '{{word_start}}(?:class_name|class|extends|signal|enum|const|var|func){{word_end}}'
      scope: storage.type.declaration.gdscript

  builtin-symbols:
    - match: '{{word_start}}{{deprecated_builtin_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.deprecated.gdscript
    - match: '{{word_start}}{{builtin_output_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.output.gdscript
    - match: '{{word_start}}{{builtin_resource_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.resource.gdscript
    - match: '{{word_start}}{{builtin_random_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.random.gdscript
    - match: '{{word_start}}{{builtin_math_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.math.gdscript
    - match: '{{word_start}}{{builtin_conversion_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.conversion.gdscript
    - match: '{{word_start}}{{builtin_runtime_functions}}{{word_end}}(?=[ \t]*\()'
      scope: support.function.builtin.runtime.gdscript

    - match: '{{word_start}}{{engine_singletons}}{{word_end}}'
      scope: support.variable.singleton.gdscript

    - match: '{{word_start}}{{primitive_types}}{{word_end}}'
      scope: support.type.builtin.primitive.gdscript
    - match: '{{word_start}}{{math_types}}{{word_end}}'
      scope: support.type.builtin.math.gdscript
    - match: '{{word_start}}{{collection_types}}{{word_end}}'
      scope: support.type.builtin.collection.gdscript
    - match: '{{word_start}}{{core_types}}{{word_end}}'
      scope: support.type.builtin.core.gdscript
    - match: '{{word_start}}{{acronym_classes}}{{word_end}}'
      scope: support.class.engine-or-user.gdscript

    # Engine classes and user classes conventionally use PascalCase. Requiring
    # at least one lowercase letter keeps SCREAMING_SNAKE_CASE constants in
    # their own semantic family.
    - match: '{{word_start}}(?={{identifier_continue}}*\p{Ll})[\p{Lu}\p{Lt}]{{identifier_continue}}*{{word_end}}'
      scope: support.class.engine-or-user.gdscript

  member-access:
    - match: '(\.)([ \t]*)({{identifier}})(?=[ \t]*\()'
      captures:
        1: punctuation.accessor.dot.gdscript
        3: entity.name.function.method.call.gdscript
    - match: '(\.)([ \t]*)({{identifier}})'
      captures:
        1: punctuation.accessor.dot.gdscript
        3: variable.other.member.gdscript

  identifiers:
    - match: '{{word_start}}(?:PI|TAU|INF|NAN){{word_end}}'
      scope: constant.language.numeric.gdscript
    - match: '{{word_start}}\p{Lu}(?:\p{Lu}|\p{Nd}|_)*(?:\p{Lu}|\p{Nd}){{word_end}}'
      scope: variable.other.constant.gdscript
    - match: '{{word_start}}_{{word_end}}'
      scope: variable.language.discard.gdscript
    - match: '{{word_start}}{{identifier}}{{word_end}}(?=[ \t]*\()'
      scope: entity.name.function.call.gdscript
    - match: '{{word_start}}{{identifier}}{{word_end}}'
      scope: variable.other.readwrite.gdscript

  literals:
    - match: '{{word_start}}null{{word_end}}'
      scope: constant.language.null.gdscript
    - match: '{{word_start}}(?:true|false){{word_end}}'
      scope: constant.language.boolean.gdscript

  # -----------------------------------------------------------------------
  # Types
  # -----------------------------------------------------------------------

  type-atoms:
    - match: '{{word_start}}{{primitive_types}}{{word_end}}'
      scope: storage.type.builtin.primitive.gdscript
    - match: '{{word_start}}{{math_types}}{{word_end}}'
      scope: storage.type.builtin.math.gdscript
    - match: '{{word_start}}{{collection_types}}{{word_end}}'
      scope: storage.type.builtin.collection.gdscript
    - match: '{{word_start}}{{core_types}}{{word_end}}'
      scope: storage.type.builtin.core.gdscript
    - match: '{{word_start}}{{identifier}}{{word_end}}'
      scope: storage.type.user.gdscript
    - match: '\['
      scope: punctuation.section.type-arguments.begin.gdscript
      push: type-arguments
    - match: '\.'
      scope: punctuation.accessor.namespace.gdscript
    - match: ','
      scope: punctuation.separator.type-arguments.gdscript

  type-arguments:
    - meta_scope: meta.type.arguments.gdscript
    - match: '\]'
      scope: punctuation.section.type-arguments.end.gdscript
      pop: true
    - include: type-atoms

  # -----------------------------------------------------------------------
  # Strings, StringNames, NodePaths and node shorthand
  # -----------------------------------------------------------------------

  strings:
    # StringName and NodePath literals are semantically distinct from String.
    - match: '(&)(")'
      captures:
        1: punctuation.definition.string-name.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: string-name-double

    - match: '(\^)(")'
      captures:
        1: punctuation.definition.node-path.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: node-path-double

    # Raw strings precede ordinary quote rules.
    - match: '{{word_start}}(r)(""")'
      captures:
        1: storage.type.string.raw.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: raw-triple-double

    - match: "{{word_start}}(r)(''')"
      captures:
        1: storage.type.string.raw.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: raw-triple-single

    - match: '{{word_start}}(r)(")'
      captures:
        1: storage.type.string.raw.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: raw-double

    - match: "{{word_start}}(r)(')"
      captures:
        1: storage.type.string.raw.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: raw-single

    - match: '"""'
      scope: punctuation.definition.string.begin.gdscript
      push: triple-double

    - match: "'''"
      scope: punctuation.definition.string.begin.gdscript
      push: triple-single

    - match: '"'
      scope: punctuation.definition.string.begin.gdscript
      push: double-string

    - match: "'"
      scope: punctuation.definition.string.begin.gdscript
      push: single-string

  double-string:
    - meta_scope: string.quoted.double.gdscript
    - meta_include_prototype: false
    - match: '"'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: regular-string-content
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  single-string:
    - meta_scope: string.quoted.single.gdscript
    - meta_include_prototype: false
    - match: "'"
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: regular-string-content
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  triple-double:
    - meta_scope: string.quoted.triple.double.gdscript
    - meta_include_prototype: false
    - match: '"""'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: regular-string-content

  triple-single:
    - meta_scope: string.quoted.triple.single.gdscript
    - meta_include_prototype: false
    - match: "'''"
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: regular-string-content

  raw-double:
    - meta_scope: string.quoted.double.raw.gdscript
    - meta_include_prototype: false
    - match: '"'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - match: '\\(?:\\|")'
      scope: constant.character.escape.raw.gdscript
    - include: string-formatting
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  raw-single:
    - meta_scope: string.quoted.single.raw.gdscript
    - meta_include_prototype: false
    - match: |-
        '
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - match: |-
        \\(?:\\|')
      scope: constant.character.escape.raw.gdscript
    - include: string-formatting
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  raw-triple-double:
    - meta_scope: string.quoted.triple.double.raw.gdscript
    - meta_include_prototype: false
    - match: '"""'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - match: '\\(?:\\|")'
      scope: constant.character.escape.raw.gdscript
    - include: string-formatting

  raw-triple-single:
    - meta_scope: string.quoted.triple.single.raw.gdscript
    - meta_include_prototype: false
    - match: |-
        '''
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - match: |-
        \\(?:\\|')
      scope: constant.character.escape.raw.gdscript
    - include: string-formatting

  string-name-double:
    - meta_scope: string.quoted.double.string-name.gdscript
    - meta_include_prototype: false
    - match: '"'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: string-escapes
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  node-path-double:
    - meta_scope: string.quoted.double.node-path.gdscript
    - meta_include_prototype: false
    - match: '"'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: string-escapes
    - match: '[:/]'
      scope: punctuation.separator.node-path.gdscript
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  node-shorthand-double:
    - meta_scope: string.quoted.double.node-shorthand.gdscript
    - meta_include_prototype: false
    - match: '"'
      scope: punctuation.definition.string.end.gdscript
      pop: true
    - include: string-escapes
    - match: '[:/]'
      scope: punctuation.separator.node-path.gdscript
    - match: '\r?\n'
      scope: invalid.illegal.unclosed-string.gdscript
      pop: true

  regular-string-content:
    - include: string-escapes
    - include: string-formatting

  string-escapes:
    - match: '\\(?:[ntrabfv"''\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{6}|\r?\n)'
      scope: constant.character.escape.gdscript
    - match: '\\.'
      scope: invalid.illegal.escape.gdscript

  string-formatting:
    - match: '%(?:[-+ 0#]*)(?:\d+|\*)?(?:\.(?:\d+|\*))?[bcdiouxXeEfFgGosv%]'
      scope: constant.other.placeholder.printf.gdscript
    - match: '\{\{|\}\}'
      scope: constant.character.escape.brace.gdscript
    - match: '\{(?:{{identifier}}|\d+)(?:![rsa])?(?::[^{}\r\n]+)?\}'
      scope: constant.other.placeholder.format.gdscript
    - match: '(?:res|user|uid)://[^\s"''<>]*'
      scope: support.constant.resource-path.gdscript

  node-shorthands:
    - match: '(\$)(")'
      captures:
        1: punctuation.definition.node-shorthand.gdscript
        2: punctuation.definition.string.begin.gdscript
      push: node-shorthand-double

    - match: '(\$)((?:(?:{{identifier}}|\.\.?)(?:/(?:{{identifier}}|\.\.?))*))'
      captures:
        1: punctuation.definition.node-shorthand.gdscript
        2: variable.other.node-path.shorthand.gdscript

    # `%Name` is lexically ambiguous with modulo. Reject the unspaced
    # operand forms (`a%b`, `call()%b`) while preserving Godot's shorthand
    # after whitespace and expression punctuation. The conventional spaced
    # modulo form (`a % b`) remains unambiguous because `%` is followed by
    # whitespace rather than an identifier.
    - match: '(?<!{{identifier_continue}})(?<![\)\]\}"''])(%)({{identifier}})'
      captures:
        1: punctuation.definition.unique-node.gdscript
        2: variable.other.node-path.unique.gdscript

  # -----------------------------------------------------------------------
  # Numeric literals
  # -----------------------------------------------------------------------

  numbers:
    - match: '{{word_start}}0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*{{word_end}}'
      scope: constant.numeric.integer.hexadecimal.gdscript
    - match: '{{word_start}}0[bB][01](?:_?[01])*{{word_end}}'
      scope: constant.numeric.integer.binary.gdscript
    - match: '(?<!{{identifier_continue}})(?:\d(?:_?\d)*)?\.(?!\.)(?:\d(?:_?\d)*)(?:[eE][+-]?\d(?:_?\d)*)?(?!{{identifier_continue}})'
      scope: constant.numeric.float.gdscript
    - match: '{{word_start}}\d(?:_?\d)*\.(?!\.)(?:[eE][+-]?\d(?:_?\d)*)?(?!{{identifier_continue}})'
      scope: constant.numeric.float.gdscript
    - match: '{{word_start}}\d(?:_?\d)*[eE][+-]?\d(?:_?\d)*{{word_end}}'
      scope: constant.numeric.float.exponent.gdscript
    - match: '{{word_start}}\d(?:_?\d)*{{word_end}}'
      scope: constant.numeric.integer.decimal.gdscript

  # -----------------------------------------------------------------------
  # Delimiters, operators and ordinary grouping
  # -----------------------------------------------------------------------

  groups:
    - match: '\('
      scope: punctuation.section.group.begin.gdscript
      push: paren-group
    - match: '\['
      scope: punctuation.section.brackets.begin.gdscript
      push: bracket-group
    - match: '\{'
      scope: punctuation.section.braces.begin.gdscript
      push: brace-group

  paren-group:
    - meta_scope: meta.group.gdscript
    - match: '\)'
      scope: punctuation.section.group.end.gdscript
      pop: true
    - include: expressions

  bracket-group:
    - meta_scope: meta.sequence.array.gdscript
    - match: '\]'
      scope: punctuation.section.brackets.end.gdscript
      pop: true
    - include: expressions

  brace-group:
    - meta_scope: meta.mapping.dictionary.gdscript
    - match: '\}'
      scope: punctuation.section.braces.end.gdscript
      pop: true
    - match: '({{identifier}})(?=[ \t]*(?:=|:))'
      captures:
        1: constant.other.key.dictionary.gdscript
    - include: expressions

  operators:
    - match: '\\[ \t]*\r?\n'
      scope: punctuation.separator.continuation.line.gdscript
    - match: ':=|\*\*=|<<=|>>=|\+=|-=|\*=|/=|%=|&=|\|=|\^=|='
      scope: keyword.operator.assignment.gdscript
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.gdscript
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.gdscript
    - match: '\*\*|\+|-|\*|/|%'
      scope: keyword.operator.arithmetic.gdscript
    - match: '<<|>>|&|\||\^|~'
      scope: keyword.operator.bitwise.gdscript
    - match: '\.\.\.'
      scope: keyword.operator.variadic-or-rest.gdscript
    - match: '\.\.'
      scope: keyword.operator.range-or-rest.gdscript
    - match: '->'
      scope: punctuation.separator.return-type.gdscript

  punctuation:
    - match: ','
      scope: punctuation.separator.sequence.gdscript
    - match: ':'
      scope: punctuation.separator.key-value-or-suite.gdscript
    - match: ';'
      scope: punctuation.terminator.statement.gdscript
    - match: '\.'
      scope: punctuation.accessor.dot.gdscript

  invalid-source:
    - match: '[?`]'
      scope: invalid.illegal.character.gdscript
    - match: '[\)\]\}]'
      scope: invalid.illegal.unmatched-delimiter.gdscript
    - match: '\\'
      scope: invalid.illegal.stray-backslash.gdscript

  # -----------------------------------------------------------------------
  # Comments, documentation comments and regions
  # -----------------------------------------------------------------------

  comments:
    - match: '^(\s*)(#)(region|endregion){{word_end}}(.*)$'
      scope: comment.line.region.gdscript
      captures:
        2: punctuation.definition.comment.gdscript
        3: keyword.other.region.gdscript

    - match: '##'
      scope: punctuation.definition.comment.documentation.gdscript
      push: documentation-comment-body

    - match: '#'
      scope: punctuation.definition.comment.gdscript
      push: comment-body

  documentation-comment-body:
    - meta_scope: comment.line.documentation.gdscript
    - meta_include_prototype: false
    - match: '(?=\r?$)'
      pop: true
    - include: comment-markers
    - include: documentation-tags

  comment-body:
    - meta_scope: comment.line.number-sign.gdscript
    - meta_include_prototype: false
    - match: '(?=\r?$)'
      pop: true
    - include: comment-markers

  comment-markers:
    - match: '{{word_start}}{{critical_marker}}{{word_end}}'
      scope: markup.warning.critical.comment.gdscript
    - match: '{{word_start}}{{warning_marker}}{{word_end}}'
      scope: markup.warning.comment.gdscript
    - match: '{{word_start}}{{notice_marker}}{{word_end}}'
      scope: markup.note.comment.gdscript
    - match: '(?:https?|ftp)://[^\s\]]+'
      scope: markup.underline.link.gdscript

  documentation-tags:
    - match: '(\[/?)(?:b|i|u|s|code|codeblock|codeblocks|gdscript|csharp|kbd|center|right|fill|indent|url|img|color|font|font_size|lang|br|lb|rb|p|ul|ol|li|table|cell|method|member|signal|constant|enum|class|constructor|operator|annotation|param|theme_item)(?:[ =][^\]]*)?(\])'
      scope: meta.tag.documentation.gdscript
      captures:
        1: punctuation.definition.tag.begin.gdscript
        2: punctuation.definition.tag.end.gdscript
    - match: '(\[)(@?{{identifier}}(?:\.{{identifier}})*)(\])'
      captures:
        1: punctuation.definition.link.begin.gdscript
        2: markup.underline.link.class.documentation.gdscript
        3: punctuation.definition.link.end.gdscript
    - match: '`[^`]+`'
      scope: markup.raw.inline.gdscript
    - include: comment-markers

  merge-conflict-markers:
    - match: '^(?:<<<<<<<|=======|>>>>>>>|\|\|\|\|\|\|\|)(?: .*)?$'
      scope: invalid.illegal.merge-conflict.gdscript
