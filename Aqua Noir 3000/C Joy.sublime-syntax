%YAML 1.2
---
name: C Joy
scope: source.c.joy
version: 2
extends: Packages/C++/C.sublime-syntax
file_extensions:
  - c
  - i
first_line_match: |-
  (?xi:
    ^ \s* // .*? -\*- .*? \bc\b(?![#+]) .*? -\*-
  )

# C Joy deliberately inherits Sublime Text's maintained C parser. These
# prepended rules add a semantic reading layer without replacing the parser's
# handling of declarators, preprocessor branches, C23 literals or attributes.

variables:
  joy_c_integer_types: '(?:char|signed|unsigned|short|int|long|_BitInt)'
  joy_c_float_types: '(?:float|double|_Decimal32|_Decimal64|_Decimal128)'
  joy_c_core_typedefs: '(?:size_t|ptrdiff_t|max_align_t|nullptr_t|wchar_t|wint_t|mbstate_t|va_list|sig_atomic_t|time_t|clock_t|fenv_t|fexcept_t|jmp_buf|FILE|fpos_t)'
  joy_c_fixed_types: '(?:u?int(?:8|16|32|64)_t|u?int_(?:least|fast)(?:8|16|32|64)_t|u?intptr_t|u?intmax_t)'
  joy_c_atomic_types: '(?:atomic_(?:bool|char|schar|uchar|short|ushort|int|uint|long|ulong|llong|ullong|char8_t|char16_t|char32_t|wchar_t|flag|size_t|ptrdiff_t)|memory_order)'

  joy_c_memory_functions: '(?:aligned_alloc|calloc|free|malloc|realloc|memccpy|memchr|memcmp|memcpy|memmove|memset|memset_explicit)'
  joy_c_string_functions: '(?:strlen|strnlen|strcmp|strncmp|strcoll|strcpy|strncpy|strcat|strncat|strchr|strrchr|strstr|strpbrk|strspn|strcspn|strtok|strerror|strxfrm)'
  joy_c_io_functions: '(?:printf|fprintf|sprintf|snprintf|vprintf|vfprintf|vsprintf|vsnprintf|scanf|fscanf|sscanf|fopen|freopen|fclose|fflush|fread|fwrite|fseek|ftell|rewind|fgetpos|fsetpos|fgetc|getchar|fgets|fputc|putchar|fputs|puts|perror|remove|rename|tmpfile|tmpnam)'
  joy_c_math_functions: '(?:abs|labs|llabs|fabs|fabsf|fabsl|sqrt|sqrtf|sqrtl|pow|powf|powl|sin|sinf|sinl|cos|cosf|cosl|tan|tanf|tanl|exp|expf|expl|log|logf|logl|floor|ceil|round|trunc|fmod|remainder|hypot|fma)'
  joy_c_conversion_functions: '(?:atoi|atol|atoll|strtol|strtoll|strtoul|strtoull|strtof|strtod|strtold|mbrtowc|wcrtomb|mbsrtowcs|wcsrtombs)'
  joy_c_process_functions: '(?:abort|atexit|at_quick_exit|exit|quick_exit|_Exit|getenv|system|bsearch|qsort|rand|srand)'
  joy_c_atomic_functions: '(?:atomic_(?:init|is_lock_free|store|store_explicit|load|load_explicit|exchange|exchange_explicit|compare_exchange_(?:weak|strong)(?:_explicit)?|fetch_(?:add|sub|or|xor|and)(?:_explicit)?|flag_(?:test|test_explicit|test_and_set|test_and_set_explicit|clear|clear_explicit)|thread_fence|signal_fence))'
  joy_c_thread_functions: '(?:thrd_(?:create|current|detach|equal|exit|join|sleep|yield)|mtx_(?:init|lock|timedlock|trylock|unlock|destroy)|cnd_(?:init|signal|broadcast|wait|timedwait|destroy)|tss_(?:create|get|set|delete)|call_once)'

  joy_critical_marker: '(?:ALERT|ATTENTION|CAUTION|CRITICAL|DANGER|SECURITY)'
  joy_warning_marker: '(?:BUG|DEPRECATED|FIXME|HACK|TASK|TBD|TODO|WARNING)'
  joy_notice_marker: '(?:INFO|NOTE|NOTICE|PERF|TEST|TESTING)'

contexts:
  modifiers:
    - meta_prepend: true
    - match: '\b(static|extern|register|thread_local|_Thread_local)\b'
      scope: storage.modifier.storage-duration.c.joy
    - match: '\b(const|volatile|restrict|__restrict|__restrict__)\b'
      scope: storage.modifier.type-qualifier.c.joy
    - match: '\b(inline|_Noreturn|noreturn)\b'
      scope: storage.modifier.function-intent.c.joy
    - match: '\b(constexpr)\b'
      scope: storage.modifier.constant-evaluation.c.joy

  keywords:
    - meta_prepend: true
    - match: '\b(return)\b'
      scope: keyword.control.flow.return.c.joy
    - match: '\b(goto)\b'
      scope: keyword.control.flow.goto.c.joy
    - match: '\b(break|continue)\b'
      scope: keyword.control.flow.loop.c.joy
    - match: '\b(if|else|switch|case|default)\b'
      scope: keyword.control.conditional.c.joy
    - match: '\b(for|while|do)\b'
      scope: keyword.control.loop.c.joy
    - match: '\b(_Generic|typeof|typeof_unqual|__typeof__?)\b'
      scope: keyword.operator.type-introspection.c.joy
    - match: '\b(static_assert|_Static_assert)\b'
      scope: keyword.control.assert.c.joy

  types:
    - meta_prepend: true
    - match: '\b(bool|_Bool)\b'
      scope: support.type.scalar.boolean.c.joy
    - match: '\b({{joy_c_float_types}})\b'
      scope: support.type.scalar.floating.c.joy
    - match: '\b({{joy_c_integer_types}})\b'
      scope: support.type.scalar.integer.c.joy
    - match: '\b(void)\b'
      scope: support.type.void.c.joy
    - match: '\b(_Complex|complex|_Imaginary|imaginary)\b'
      scope: support.type.complex.c.joy
    - match: '\b({{joy_c_atomic_types}})\b'
      scope: support.type.atomic.c.joy
    - match: '\b({{joy_c_fixed_types}})\b'
      scope: support.type.fixed-width.c.joy
    - match: '\b({{joy_c_core_typedefs}})\b'
      scope: support.type.standard.c.joy
    - match: '\b([[:alpha:]_][[:alnum:]_]*_t)\b'
      scope: support.type.typedef-convention.c.joy

  constants:
    - meta_prepend: true
    - match: '\b(true|false)\b'
      scope: constant.language.boolean.c.joy
    - match: '\b(nullptr|NULL)\b'
      scope: constant.language.null.c.joy
    - match: '\b(__func__|__FILE__|__LINE__|__DATE__|__TIME__|__STDC__|__STDC_VERSION__|__STDC_HOSTED__)\b'
      scope: support.constant.compiler.c.joy
    - match: '\b(?:CHAR_BIT|SCHAR_MIN|SCHAR_MAX|UCHAR_MAX|SHRT_MIN|SHRT_MAX|USHRT_MAX|INT_MIN|INT_MAX|UINT_MAX|LONG_MIN|LONG_MAX|ULONG_MAX|LLONG_MIN|LLONG_MAX|ULLONG_MAX|SIZE_MAX|PTRDIFF_MIN|PTRDIFF_MAX|INTPTR_MIN|INTPTR_MAX|UINTPTR_MAX|NAN|INFINITY|HUGE_VALF?|HUGE_VALL)\b'
      scope: support.constant.standard.c.joy

  variables:
    - meta_prepend: true
    - match: '\b[A-Z][A-Z0-9_]{2,}\b'
      scope: constant.other.macro-reference.c.joy

  function-call:
    - meta_prepend: true
    - match: '\b({{joy_c_memory_functions}})(?=\s*\()'
      scope: support.function.memory.c.joy
    - match: '\b({{joy_c_string_functions}})(?=\s*\()'
      scope: support.function.string.c.joy
    - match: '\b({{joy_c_io_functions}})(?=\s*\()'
      scope: support.function.io.c.joy
    - match: '\b({{joy_c_math_functions}})(?=\s*\()'
      scope: support.function.math.c.joy
    - match: '\b({{joy_c_conversion_functions}})(?=\s*\()'
      scope: support.function.conversion.c.joy
    - match: '\b({{joy_c_process_functions}})(?=\s*\()'
      scope: support.function.process.c.joy
    - match: '\b({{joy_c_atomic_functions}})(?=\s*\()'
      scope: support.function.atomic.c.joy
    - match: '\b({{joy_c_thread_functions}})(?=\s*\()'
      scope: support.function.thread.c.joy

  preprocessor-macro-definition:
    - meta_prepend: true
    - match: '##'
      scope: keyword.operator.token-paste.preprocessor.c.joy
    - match: '#(?=[[:alpha:]_])'
      scope: keyword.operator.stringification.preprocessor.c.joy
    - match: '\b(__VA_ARGS__|__VA_OPT__)\b'
      scope: variable.language.variadic.preprocessor.c.joy
    - match: '\b[A-Z][A-Z0-9_]{2,}\b'
      scope: constant.other.macro-reference.c.joy

  line-comment-body:
    - meta_prepend: true
    - include: joy-comment-content

  line-comment-documentation-body:
    - meta_prepend: true
    - include: joy-documentation-content
    - include: joy-comment-content

  block-comment-body:
    - meta_prepend: true
    - include: joy-comment-content

  block-comment-documentation-body:
    - meta_prepend: true
    - include: joy-documentation-content
    - include: joy-comment-content

  joy-comment-content:
    - match: '\b{{joy_critical_marker}}\b(?=:|\b)'
      scope: markup.warning.critical.comment.c.joy
    - match: '\b{{joy_warning_marker}}\b(?=:|\b)'
      scope: markup.warning.comment.c.joy
    - match: '\b{{joy_notice_marker}}\b(?=:|\b)'
      scope: markup.note.comment.c.joy
    - match: '(?:https?|ftp)://[^\s<>\])}]+'
      scope: markup.underline.link.c.joy

  joy-documentation-content:
    - match: '(?<![[:alnum:]_])(@|\\)(brief|details|param|tparam|return|returns|retval|throws|exception|pre|post|invariant|note|warning|attention|deprecated|since|see|sa|code|endcode|file|author|version|copyright)\b'
      captures:
        1: punctuation.definition.documentation.c.joy
        2: keyword.other.documentation.c.joy
    - match: '`[^`\n]+`'
      scope: markup.raw.inline.documentation.c.joy
