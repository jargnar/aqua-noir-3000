%YAML 1.2
---
name: Dart Joy
scope: source.dart.joy
version: 2
file_extensions:
  - dart
first_line_match: '^#!.*\bdart\b'

# Dart Joy is a standalone Dart 3.x syntax for Sublime Text 4.
# Its scopes prioritize semantic reading: declarations over references,
# control flow over punctuation, and null-safety, async flow, metadata,
# patterns, types, private names, members and calls as separate landmarks.

variables:
  identifier_start: '[\p{L}\p{Nl}_$]'
  identifier_continue: '[\p{L}\p{Nl}\p{Mn}\p{Mc}\p{Nd}\p{Pc}_$]'
  identifier: '{{identifier_start}}{{identifier_continue}}*'
  private_identifier: '_{{identifier_continue}}+'
  word_start: '(?<!{{identifier_continue}})'
  word_end: '(?!{{identifier_continue}})'
  conventional_type: '_*[\p{Lu}\p{Lt}]{{identifier_continue}}*'

  scalar_types: '(?:bool|num|int|double)'
  top_types: '(?:void|dynamic|Never|Null|Object|Function|Record|Enum)'
  text_types: '(?:String|StringBuffer|Runes|RegExp|Match|Symbol|Uri)'
  collection_types: '(?:List|Set|Map|Iterable|Iterator|MapEntry)'
  async_types: '(?:Future|FutureOr|Stream|StreamSubscription|StreamController|Completer|Timer)'
  core_types: '(?:BigInt|DateTime|Duration|Stopwatch|Type|Expando|WeakReference|Finalizer|Invocation|StackTrace)'
  error_types: '(?:Error|Exception|ArgumentError|AssertionError|CastError|ConcurrentModificationError|FormatException|IndexError|NoSuchMethodError|RangeError|StateError|TypeError|UnimplementedError|UnsupportedError|TimeoutException)'
  builtin_type: '(?:{{scalar_types}}|{{top_types}}|{{text_types}}|{{collection_types}}|{{async_types}}|{{core_types}}|{{error_types}})'
  type_name: '(?:{{builtin_type}}|{{conventional_type}})'
  type_expression: '(?:{{type_name}}(?:[ \t]*<[^\n(){};=]+>)?(?:[ \t]*\?)?)'

  class_modifier: '(?:abstract|base|final|interface|sealed)'
  declaration_modifier: '(?:external|static|abstract|covariant|native)'
  async_keyword: '(?:async\*?|sync\*?|await|yield\*?)'
  exception_keyword: '(?:try|on|catch|finally|throw|rethrow)'
  control_keyword: '(?:break|case|continue|default|do|else|for|if|in|switch|when|while)'

  core_annotations: '(?:Deprecated|Since|deprecated|override|pragma)'
  analyzer_annotations: '(?:alwaysThrows|doNotStore|factory|immutable|internal|isTest|isTestGroup|literal|mustBeOverridden|mustCallSuper|nonVirtual|optionalTypeArgs|protected|redeclare|reopen|sealed|useResult|visibleForOverriding|visibleForTesting)'
  core_functions: '(?:identical|identityHashCode|print)'

  critical_marker: '(?:ALERT|ATTENTION|CAUTION|CRITICAL|DANGER|SECURITY)'
  warning_marker: '(?:BUG|DEPRECATED|FIXME|HACK|TASK|TBD|TODO|WARNING)'
  notice_marker: '(?:INFO|NOTE|NOTICE|PERF|TEST|TESTING)'

contexts:
  prototype:
    - include: merge-conflict-markers
    - include: comments

  main:
    - include: shebang
    - include: code

  code:
    - include: directives
    - include: annotations
    - include: declarations
    - include: expressions

  shebang:
    - match: '^#!.*$'
      scope: comment.line.shebang.dart.joy

  # ------------------------------------------------------------------
  # Directives and metadata
  # ------------------------------------------------------------------

  directives:
    - match: |-
        (?x)
        ^([ \t]*)
        (augment[ \t]+library|import[ \t]+augment|part[ \t]+of|library|import|export|part)
        {{word_end}}
      captures:
        2: keyword.control.directive.dart.joy
      push: directive-tail

  directive-tail:
    - meta_scope: meta.directive.dart.joy
    - match: ';'
      scope: punctuation.terminator.statement.dart.joy
      pop: true
    - match: '{{word_start}}(deferred){{word_end}}'
      scope: storage.modifier.deferred.dart.joy
    - match: '{{word_start}}(as){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: keyword.other.alias.dart.joy
        2: entity.name.namespace.alias.dart.joy
    - match: '{{word_start}}(show|hide){{word_end}}'
      scope: keyword.control.directive.combinator.dart.joy
    - match: '{{word_start}}(if){{word_end}}'
      scope: keyword.control.conditional.dart.joy
    - include: strings
    - include: constants
    - include: numbers
    - match: '{{identifier}}'
      scope: entity.name.reference.directive.dart.joy
    - match: '\.'
      scope: punctuation.accessor.dot.dart.joy
    - match: ','
      scope: punctuation.separator.sequence.dart.joy
    - include: expression-groups

  annotations:
    - match: '(@)({{core_annotations}}){{word_end}}'
      captures:
        1: punctuation.definition.annotation.dart.joy
        2: storage.modifier.annotation.core.dart.joy
    - match: '(@)({{analyzer_annotations}}){{word_end}}'
      captures:
        1: punctuation.definition.annotation.dart.joy
        2: storage.modifier.annotation.analyzer.dart.joy
    - match: '(@)({{identifier}}(?:[ \t]*\.[ \t]*{{identifier}})*)'
      captures:
        1: punctuation.definition.annotation.dart.joy
        2: entity.other.attribute-name.annotation.dart.joy

  # ------------------------------------------------------------------
  # Declarations: strong colors are reserved for definition sites.
  # ------------------------------------------------------------------

  declarations:
    # Class-family declarations and modern class modifiers.
    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:{{class_modifier}}|augment)[ \t]+)*)
        (mixin[ \t]+class|class)[ \t]+
        ({{identifier}})
      captures:
        2: storage.modifier.class.dart.joy
        3: keyword.declaration.class.dart.joy
        4: entity.name.type.class.dart.joy

    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:base|final|sealed|augment)[ \t]+)*)
        (mixin)[ \t]+
        ({{identifier}})
      captures:
        2: storage.modifier.class.dart.joy
        3: keyword.declaration.mixin.dart.joy
        4: entity.name.type.mixin.dart.joy

    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:augment)[ \t]+)*)
        (enum)[ \t]+
        ({{identifier}})
      captures:
        2: storage.modifier.augmentation.dart.joy
        3: keyword.declaration.enum.dart.joy
        4: entity.name.type.enum.dart.joy
      push: enum-declaration-tail

    - match: |-
        (?x)
        ^([ \t]*)
        ((?:augment[ \t]+)?)
        (extension)[ \t]+(type)[ \t]+
        ({{identifier}})
      captures:
        2: storage.modifier.augmentation.dart.joy
        3: keyword.declaration.extension.dart.joy
        4: keyword.declaration.type.dart.joy
        5: entity.name.type.extension.dart.joy

    - match: |-
        (?x)
        ^([ \t]*)
        ((?:augment[ \t]+)?)
        (extension){{word_end}}
        (?:[ \t]+({{identifier}}))?
        [ \t]+(on){{word_end}}
      captures:
        2: storage.modifier.augmentation.dart.joy
        3: keyword.declaration.extension.dart.joy
        4: entity.name.type.extension.dart.joy
        5: keyword.declaration.inheritance.dart.joy

    - match: '{{word_start}}(extends|implements|with|on){{word_end}}'
      scope: keyword.declaration.inheritance.dart.joy

    - match: |-
        (?x)
        ^([ \t]*)(typedef)[ \t]+({{identifier}})
        (?=[ \t]*(?:<|=))
      captures:
        2: keyword.declaration.typedef.dart.joy
        3: entity.name.type.typedef.dart.joy

    - match: '^([ \t]*)(typedef){{word_end}}'
      captures:
        2: keyword.declaration.typedef.dart.joy

    # Getters, setters and operator methods.
    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:{{declaration_modifier}})[ \t]+)*)
        (?:({{type_expression}})[ \t]+)?
        (get){{word_end}}[ \t]+({{identifier}})
      captures:
        2: storage.modifier.declaration.dart.joy
        3: storage.type.return.dart.joy
        4: storage.type.accessor.dart.joy
        5: entity.name.function.getter.dart.joy

    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:{{declaration_modifier}})[ \t]+)*)
        (set){{word_end}}[ \t]+({{identifier}})[ \t]*(\()
      captures:
        2: storage.modifier.declaration.dart.joy
        3: storage.type.accessor.dart.joy
        4: entity.name.function.setter.dart.joy
        5: punctuation.section.parameters.begin.dart.joy
      push: function-parameters

    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:{{declaration_modifier}})[ \t]+)*)
        (?:({{type_expression}})[ \t]+)?
        (operator){{word_end}}[ \t]*
        (\[\]=?|==|~|<<|>>>?|[+\-*/%&|^<>]=?)
        [ \t]*(\()
      captures:
        2: storage.modifier.declaration.dart.joy
        3: storage.type.return.dart.joy
        4: storage.type.operator.dart.joy
        5: entity.name.function.operator.dart.joy
        6: punctuation.section.parameters.begin.dart.joy
      push: function-parameters

    # Constructors and named constructors. Anchoring keeps ordinary calls out.
    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:external|factory|const)[ \t]+)*)
        ({{conventional_type}})
        (?:[ \t]*(\.)[ \t]*({{identifier}}))?
        [ \t]*(\()
      captures:
        2: storage.modifier.constructor.dart.joy
        3: entity.name.function.constructor.dart.joy
        4: punctuation.accessor.dot.dart.joy
        5: entity.name.function.constructor.named.dart.joy
        6: punctuation.section.parameters.begin.dart.joy
      push: function-parameters

    # Explicit return-type function and method declarations.
    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:{{declaration_modifier}})[ \t]+)*)
        ({{type_expression}})[ \t]+
        ({{identifier}})
        ([ \t]*<[^\n(){};=]+>)?
        [ \t]*(\()
      captures:
        2: storage.modifier.declaration.dart.joy
        3: storage.type.return.dart.joy
        4: entity.name.function.dart.joy
        5: meta.generic.parameters.dart.joy
        6: punctuation.section.parameters.begin.dart.joy
      push: function-parameters

    # Implicit-dynamic declarations require a body/arrow shape on the line.
    - match: |-
        (?x)
        ^([ \t]*)
        ((?:(?:external|static|abstract)[ \t]+)*)
        ({{identifier}})
        ([ \t]*<[^\n(){};=]+>)?
        [ \t]*(\()
        (?=[^;\n]*\)[ \t]*(?:(?:async|async\*|sync|sync\*)[ \t]*)?(?:=>|\{|$))
      captures:
        2: storage.modifier.declaration.dart.joy
        3: entity.name.function.dart.joy
        4: meta.generic.parameters.dart.joy
        5: punctuation.section.parameters.begin.dart.joy
      push: function-parameters

    - include: pattern-declarations
    - include: variable-declarations

    - match: '{{word_start}}(external|static|abstract|covariant|native|macro|augment){{word_end}}'
      scope: storage.modifier.declaration.dart.joy

  enum-declaration-tail:
    - meta_scope: meta.declaration.enum.dart.joy
    - match: '\{'
      scope: punctuation.section.block.begin.dart.joy
      set: enum-values-body
    - match: ';'
      scope: punctuation.terminator.statement.dart.joy
      pop: true
    - include: type-atoms
    - include: operators
    - include: punctuation

  enum-values-body:
    - meta_scope: meta.enum.values.dart.joy
    - match: '\}'
      scope: punctuation.section.block.end.dart.joy
      pop: true
    - match: ';'
      scope: punctuation.terminator.enum-values.dart.joy
      set: enum-members-body
    - match: '{{identifier}}(?=[ \t]*(?:\(|,|;|\}))'
      scope: entity.name.constant.enum.dart.joy
    - include: code

  enum-members-body:
    - meta_scope: meta.enum.members.dart.joy
    - match: '\}'
      scope: punctuation.section.block.end.dart.joy
      pop: true
    - include: code

  variable-declarations:
    # Typed const/final declarations.
    - match: |-
        (?x)
        {{word_start}}
        ((?:late[ \t]+)?const){{word_end}}[ \t]+
        ({{type_expression}})[ \t]+
        ({{identifier}})
      captures:
        1: storage.modifier.constant.dart.joy
        2: storage.type.variable.dart.joy
        3: entity.name.constant.dart.joy

    - match: |-
        (?x)
        {{word_start}}
        ((?:late[ \t]+)?final){{word_end}}[ \t]+
        ({{type_expression}})[ \t]+
        ({{identifier}})
      captures:
        1: storage.modifier.final.dart.joy
        2: storage.type.variable.dart.joy
        3: variable.other.declaration.dart.joy

    - match: '{{word_start}}(const){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.modifier.constant.dart.joy
        2: entity.name.constant.dart.joy

    - match: '{{word_start}}((?:late[ \t]+)?(?:var|final)){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.modifier.variable.dart.joy
        2: variable.other.declaration.dart.joy

    - match: |-
        (?x)
        {{word_start}}(late){{word_end}}[ \t]+
        ({{type_expression}})[ \t]+
        ({{identifier}})
      captures:
        1: storage.modifier.late.dart.joy
        2: storage.type.variable.dart.joy
        3: variable.other.declaration.dart.joy

    - match: '({{type_expression}})[ \t]+({{identifier}})(?=[ \t]*(?:=|,|;|\)|\]|\}|\bin\b))'
      captures:
        1: storage.type.variable.dart.joy
        2: variable.other.declaration.dart.joy

  pattern-declarations:
    - match: '{{word_start}}(var|final){{word_end}}[ \t]*(\()'
      captures:
        1: storage.modifier.pattern.dart.joy
        2: punctuation.section.record.begin.dart.joy
      push: record-pattern-body
    - match: '{{word_start}}(var|final){{word_end}}[ \t]*(\[)'
      captures:
        1: storage.modifier.pattern.dart.joy
        2: punctuation.section.brackets.begin.dart.joy
      push: list-pattern-body
    - match: '{{word_start}}(var|final){{word_end}}[ \t]*(\{)'
      captures:
        1: storage.modifier.pattern.dart.joy
        2: punctuation.section.braces.begin.dart.joy
      push: map-pattern-body

  function-parameters:
    - meta_scope: meta.function.parameters.dart.joy
    - match: '\)'
      scope: punctuation.section.parameters.end.dart.joy
      pop: true
    - match: '\{'
      scope: punctuation.section.parameters.named.begin.dart.joy
      push: named-parameter-group
    - match: '\['
      scope: punctuation.section.parameters.optional.begin.dart.joy
      push: optional-parameter-group
    - include: parameter-declarations
    - include: expressions

  lambda-parameters:
    - meta_scope: meta.function.parameters.lambda.dart.joy
    - match: '\)'
      scope: punctuation.section.parameters.lambda.end.dart.joy
      pop: true
    - match: '\{'
      scope: punctuation.section.parameters.named.begin.dart.joy
      push: named-parameter-group
    - match: '\['
      scope: punctuation.section.parameters.optional.begin.dart.joy
      push: optional-parameter-group
    - include: parameter-declarations
    - include: expressions

  named-parameter-group:
    - meta_scope: meta.function.parameters.named.dart.joy
    - match: '\}'
      scope: punctuation.section.parameters.named.end.dart.joy
      pop: true
    - include: parameter-declarations
    - include: expressions

  optional-parameter-group:
    - meta_scope: meta.function.parameters.optional.dart.joy
    - match: '\]'
      scope: punctuation.section.parameters.optional.end.dart.joy
      pop: true
    - include: parameter-declarations
    - include: expressions

  parameter-declarations:
    - match: '{{word_start}}(required|covariant|final|var){{word_end}}'
      scope: storage.modifier.parameter.dart.joy
    - match: '{{word_start}}(this|super){{word_end}}[ \t]*(\.)[ \t]*({{identifier}})'
      captures:
        1: variable.language.dart.joy
        2: punctuation.accessor.dot.dart.joy
        3: variable.parameter.field-formal.dart.joy
    - match: '({{type_expression}})[ \t]+({{identifier}})(?=[ \t]*(?:=|:|,|\)|\]|\}))'
      captures:
        1: storage.type.parameter.dart.joy
        2: variable.parameter.dart.joy
    - match: '{{identifier}}(?=[ \t]*(?:=|:|,|\)|\]|\}))'
      scope: variable.parameter.dart.joy
    - match: '='
      scope: keyword.operator.assignment.default.dart.joy
    - match: ':'
      scope: keyword.operator.assignment.default.dart.joy
    - match: ','
      scope: punctuation.separator.parameters.dart.joy

  # ------------------------------------------------------------------
  # Patterns
  # ------------------------------------------------------------------

  case-pattern:
    - meta_scope: meta.pattern.case.dart.joy
    - match: '{{word_start}}(when){{word_end}}'
      scope: keyword.control.pattern.guard.dart.joy
      set: case-pattern-guard
    - match: '(?=\))'
      pop: true
    - match: '=>'
      scope: keyword.operator.arrow.dart.joy
      pop: true
    - match: ':'
      scope: punctuation.separator.case.dart.joy
      pop: true
    - include: pattern-atoms
    - include: pattern-groups

  case-pattern-guard:
    - meta_scope: meta.pattern.guard.dart.joy
    - match: '(?=\))'
      pop: true
    - match: '=>'
      scope: keyword.operator.arrow.dart.joy
      pop: true
    - match: ':'
      scope: punctuation.separator.case.dart.joy
      pop: true
    - include: expressions

  record-pattern-body:
    - meta_scope: meta.pattern.record.dart.joy
    - match: '\)'
      scope: punctuation.section.record.end.dart.joy
      pop: true
    - include: pattern-atoms
    - include: pattern-groups

  list-pattern-body:
    - meta_scope: meta.pattern.list.dart.joy
    - match: '\]'
      scope: punctuation.section.brackets.end.dart.joy
      pop: true
    - include: pattern-atoms
    - include: pattern-groups

  map-pattern-body:
    - meta_scope: meta.pattern.map.dart.joy
    - match: '\}'
      scope: punctuation.section.braces.end.dart.joy
      pop: true
    - include: pattern-atoms
    - include: pattern-groups

  pattern-groups:
    - match: '\('
      scope: punctuation.section.record.begin.dart.joy
      push: record-pattern-body
    - match: '\['
      scope: punctuation.section.brackets.begin.dart.joy
      push: list-pattern-body
    - match: '\{'
      scope: punctuation.section.braces.begin.dart.joy
      push: map-pattern-body

  pattern-atoms:
    - match: '{{word_start}}(var|final){{word_end}}[ \t]+({{identifier}})'
      captures:
        1: storage.modifier.pattern.dart.joy
        2: variable.other.binding.pattern.dart.joy
    - match: '({{type_expression}})[ \t]+({{identifier}})(?=[ \t]*(?:,|\)|\]|\}|:|=>))'
      captures:
        1: storage.type.pattern.dart.joy
        2: variable.other.binding.pattern.dart.joy
    - match: '{{word_start}}(_){{word_end}}'
      scope: variable.language.wildcard.dart.joy
    - match: '\.\.\.'
      scope: keyword.operator.rest.pattern.dart.joy
    - match: '{{word_start}}(as|is){{word_end}}'
      scope: keyword.operator.type.dart.joy
    - include: strings
    - include: numbers
    - include: constants
    - include: type-atoms
    - match: '{{identifier}}(?=[ \t]*(?:,|\)|\]|\}|:|=>))'
      scope: variable.other.binding.pattern.dart.joy
    - match: ':'
      scope: punctuation.separator.key-value.dart.joy
    - match: ','
      scope: punctuation.separator.sequence.dart.joy
    - include: operators

  # ------------------------------------------------------------------
  # Expressions, names and operators
  # ------------------------------------------------------------------

  expressions:
    - include: strings
    - include: numbers
    - include: constants

    - match: '{{word_start}}(case){{word_end}}'
      scope: keyword.control.pattern.dart.joy
      push: case-pattern

    - match: '{{word_start}}({{exception_keyword}}){{word_end}}'
      scope: keyword.control.exception.dart.joy
    - match: '{{word_start}}({{async_keyword}}){{word_end}}'
      scope: keyword.control.async.dart.joy
    - match: '{{word_start}}(return){{word_end}}'
      scope: keyword.control.flow.return.dart.joy
    - match: '{{word_start}}({{control_keyword}}){{word_end}}'
      scope: keyword.control.dart.joy
    - match: '{{word_start}}(assert){{word_end}}'
      scope: keyword.control.assert.dart.joy

    - match: '{{word_start}}(this|super|augmented){{word_end}}'
      scope: variable.language.dart.joy

    - match: '{{word_start}}(new|const){{word_end}}(?=[ \t]+{{type_name}})'
      scope: keyword.operator.creation.dart.joy

    # Arrow closures are structurally important data-flow boundaries. The
    # predecessor guard avoids confusing record patterns in switch arms with
    # ordinary parenthesized lambdas.
    - match: '(?<=[=(:,\[>])([ \t]*)(\()(?=[^()\n]*\)[ \t]*(?:(?:async|async\*)[ \t]*)?=>)'
      captures:
        2: punctuation.section.parameters.lambda.begin.dart.joy
      push: lambda-parameters
    - match: '(?<=return)([ \t]+)(\()(?=[^()\n]*\)[ \t]*(?:(?:async|async\*)[ \t]*)?=>)'
      captures:
        2: punctuation.section.parameters.lambda.begin.dart.joy
      push: lambda-parameters

    # Qualified and direct constructor invocations.
    - match: '({{identifier}})(\.)({{conventional_type}})(?:[ \t]*(\.)[ \t]*({{identifier}}))?(?=[ \t]*(?:<[^\n(){};]+>)?[ \t]*\()'
      captures:
        1: entity.name.namespace.prefix.dart.joy
        2: punctuation.accessor.dot.dart.joy
        3: support.class.user.dart.joy
        4: punctuation.accessor.dot.dart.joy
        5: variable.function.constructor.named.dart.joy
    - match: '({{conventional_type}})(?:[ \t]*(\.)[ \t]*({{identifier}}))?(?=[ \t]*(?:<[^\n(){};]+>)?[ \t]*\()'
      captures:
        1: support.class.user.dart.joy
        2: punctuation.accessor.dot.dart.joy
        3: variable.function.constructor.named.dart.joy

    # Contextual dot shorthands such as `.warning` and `.new()`.
    - match: '(?<!{{identifier_continue}}|[\)\]\}])(\.)(new|{{identifier}})(?=[ \t]*(?:<[^\n(){};]+>)?[ \t]*\()'
      captures:
        1: punctuation.accessor.dot-shorthand.dart.joy
        2: variable.function.dot-shorthand.dart.joy
    - match: '(?<!{{identifier_continue}}|[\)\]\}])(\.)({{identifier}})'
      captures:
        1: punctuation.accessor.dot-shorthand.dart.joy
        2: constant.other.dot-shorthand.dart.joy

    # Member methods/properties, cascades and null-aware access.
    - match: '(\?\.\.|\.\.|\?\.|\.)([ \t]*)({{identifier}})(?=[ \t]*(?:<[^\n(){};]+>)?[ \t]*\()'
      captures:
        1: punctuation.accessor.member.dart.joy
        3: variable.function.member.dart.joy
    - match: '(\?\.\.|\.\.|\?\.|\.)([ \t]*)({{private_identifier}})'
      captures:
        1: punctuation.accessor.member.dart.joy
        3: variable.other.member.private.dart.joy
    - match: '(\?\.\.|\.\.|\?\.|\.)([ \t]*)({{identifier}})'
      captures:
        1: punctuation.accessor.member.dart.joy
        3: variable.other.member.dart.joy

    - match: '{{word_start}}({{core_functions}}){{word_end}}(?=[ \t]*\()'
      scope: support.function.core.dart.joy
    - match: '{{word_start}}({{private_identifier}}){{word_end}}(?=[ \t]*(?:<[^\n(){};]+>)?[ \t]*\()'
      scope: variable.function.private.dart.joy
    - match: '{{word_start}}({{identifier}}){{word_end}}(?=[ \t]*(?:<[^\n(){};]+>)?[ \t]*\()'
      scope: variable.function.dart.joy

    # Labels and named arguments are data-flow landmarks.
    - match: '^([ \t]*)({{identifier}})(:)'
      captures:
        2: entity.name.label.dart.joy
        3: punctuation.separator.label.dart.joy
    - match: '{{word_start}}({{identifier}}){{word_end}}(?=[ \t]*:(?!:))'
      scope: variable.parameter.label.dart.joy

    - include: type-atoms
    - include: operators
    - include: expression-groups
    - include: punctuation

    - match: '{{word_start}}(_){{word_end}}'
      scope: variable.language.wildcard.dart.joy
    - match: '{{word_start}}({{private_identifier}}){{word_end}}'
      scope: variable.other.private.dart.joy
    - match: '{{word_start}}({{identifier}}){{word_end}}'
      scope: variable.other.readwrite.dart.joy

    - match: '`'
      scope: invalid.illegal.unexpected-character.dart.joy

  constants:
    - match: '{{word_start}}(true|false){{word_end}}'
      scope: constant.language.boolean.dart.joy
    - match: '{{word_start}}(null){{word_end}}'
      scope: constant.language.null.dart.joy

  type-atoms:
    - match: '{{word_start}}({{scalar_types}}){{word_end}}'
      scope: support.type.scalar.dart.joy
    - match: '{{word_start}}({{top_types}}){{word_end}}'
      scope: support.type.top.dart.joy
    - match: '{{word_start}}({{text_types}}){{word_end}}'
      scope: support.type.text.dart.joy
    - match: '{{word_start}}({{collection_types}}){{word_end}}'
      scope: support.type.collection.dart.joy
    - match: '{{word_start}}({{async_types}}){{word_end}}'
      scope: support.type.async.dart.joy
    - match: '{{word_start}}({{core_types}}){{word_end}}'
      scope: support.type.core.dart.joy
    - match: '{{word_start}}({{error_types}}){{word_end}}'
      scope: support.type.error.dart.joy
    - match: '{{word_start}}({{conventional_type}}){{word_end}}'
      scope: support.class.user.dart.joy

  operators:
    # Null-safety and collection operators carry unusually high information.
    - match: '\?\?=|\?\?'
      scope: keyword.operator.null-coalescing.dart.joy
    - match: '\?\.\.|\.\.|\?\.|\?(?=\[)'
      scope: keyword.operator.null-aware-access.dart.joy
    - match: '\.\.\.\?|\.\.\.'
      scope: keyword.operator.spread.dart.joy
    - match: '=>'
      scope: keyword.operator.arrow.dart.joy
    - match: '{{word_start}}(is)(!)?{{word_end}}'
      captures:
        1: keyword.operator.type.dart.joy
        2: keyword.operator.logical.dart.joy
    - match: '{{word_start}}(as){{word_end}}'
      scope: keyword.operator.type.dart.joy
    - match: '===|!=='
      scope: invalid.illegal.operator.dart.joy
    - match: '==|!=|<=|>=|<|>'
      scope: keyword.operator.comparison.dart.joy
    - match: '(?<=[\p{L}\p{Nd}_>])\?(?=[ \t]*(?:[\],)>};:=]|$))'
      scope: keyword.operator.nullable.type.dart.joy
    - match: '(?<={{identifier_continue}}|[\)\]\}])!(?!=)'
      scope: keyword.operator.null-assertion.dart.joy
    - match: '&&|\|\||!'
      scope: keyword.operator.logical.dart.joy
    - match: '<<=|>>>=|>>=|&=|\|=|\^=|<<|>>>|>>|~|&|\||\^'
      scope: keyword.operator.bitwise.dart.joy
    - match: '\+\+|--'
      scope: keyword.operator.increment-decrement.dart.joy
    - match: '\+=|-=|\*=|/=|~/=|%=|='
      scope: keyword.operator.assignment.dart.joy
    - match: '~/|[+\-*/%]'
      scope: keyword.operator.arithmetic.dart.joy
    - match: '\?'
      scope: keyword.operator.ternary.dart.joy

  expression-groups:
    - match: '\('
      scope: punctuation.section.group.begin.dart.joy
      push: expression-parens
    - match: '\['
      scope: punctuation.section.brackets.begin.dart.joy
      push: expression-brackets
    - match: '\{'
      scope: punctuation.section.braces.begin.dart.joy
      push: expression-braces

  expression-parens:
    - meta_scope: meta.group.dart.joy
    - match: '\)'
      scope: punctuation.section.group.end.dart.joy
      pop: true
    - include: code

  expression-brackets:
    - meta_scope: meta.brackets.dart.joy
    - match: '\]'
      scope: punctuation.section.brackets.end.dart.joy
      pop: true
    - include: code

  expression-braces:
    - meta_scope: meta.block.dart.joy
    - match: '\}'
      scope: punctuation.section.braces.end.dart.joy
      pop: true
    - include: code

  punctuation:
    - match: ';'
      scope: punctuation.terminator.statement.dart.joy
    - match: ','
      scope: punctuation.separator.sequence.dart.joy
    - match: ':'
      scope: punctuation.separator.key-value.dart.joy
    - match: '\.'
      scope: punctuation.accessor.dot.dart.joy

  numbers:
    - match: '{{word_start}}(0[xX])([0-9A-Fa-f](?:_?[0-9A-Fa-f])*){{word_end}}'
      scope: meta.number.integer.hexadecimal.dart.joy
      captures:
        1: constant.numeric.base.dart.joy
        2: constant.numeric.value.dart.joy
    - match: |-
        (?x)
        {{word_start}}
        (
          (?:\d(?:_?\d)*)\.(?:\d(?:_?\d)*)?(?:[eE][+-]?\d(?:_?\d)*)?
          |\.(?:\d(?:_?\d)*)(?:[eE][+-]?\d(?:_?\d)*)?
          |(?:\d(?:_?\d)*)[eE][+-]?\d(?:_?\d)*
        )
        {{word_end}}
      scope: meta.number.float.decimal.dart.joy constant.numeric.value.dart.joy
    - match: '{{word_start}}\d(?:_?\d)*{{word_end}}'
      scope: meta.number.integer.decimal.dart.joy constant.numeric.value.dart.joy

  # ------------------------------------------------------------------
  # Strings and interpolation
  # ------------------------------------------------------------------

  strings:
    - match: 'r"""'
      scope: punctuation.definition.string.begin.dart.joy
      push: raw-triple-double-string
    - match: "r'''"
      scope: punctuation.definition.string.begin.dart.joy
      push: raw-triple-single-string
    - match: 'r"'
      scope: punctuation.definition.string.begin.dart.joy
      push: raw-double-string
    - match: "r'"
      scope: punctuation.definition.string.begin.dart.joy
      push: raw-single-string
    - match: '"""'
      scope: punctuation.definition.string.begin.dart.joy
      push: triple-double-string
    - match: "'''"
      scope: punctuation.definition.string.begin.dart.joy
      push: triple-single-string
    - match: '"'
      scope: punctuation.definition.string.begin.dart.joy
      push: double-string
    - match: "'"
      scope: punctuation.definition.string.begin.dart.joy
      push: single-string

  double-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.dart.joy
    - match: '"'
      scope: punctuation.definition.string.end.dart.joy
      pop: true
    - match: '(?=$)'
      pop: true
    - include: string-interpolation
    - include: string-escapes

  single-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.single.dart.joy
    - match: "'"
      scope: punctuation.definition.string.end.dart.joy
      pop: true
    - match: '(?=$)'
      pop: true
    - include: string-interpolation
    - include: string-escapes

  triple-double-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.triple.double.dart.joy
    - match: '"""'
      scope: punctuation.definition.string.end.dart.joy
      pop: true
    - include: string-interpolation
    - include: string-escapes

  triple-single-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.triple.single.dart.joy
    - match: "'''"
      scope: punctuation.definition.string.end.dart.joy
      pop: true
    - include: string-interpolation
    - include: string-escapes

  raw-double-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.double.raw.dart.joy
    - match: '"'
      scope: punctuation.definition.string.end.dart.joy
      pop: true
    - match: '(?=$)'
      pop: true

  raw-single-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.single.raw.dart.joy
    - match: "'"
      scope: punctuation.definition.string.end.dart.joy
      pop: true
    - match: '(?=$)'
      pop: true

  raw-triple-double-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.triple.double.raw.dart.joy
    - match: '"""'
      scope: punctuation.definition.string.end.dart.joy
      pop: true

  raw-triple-single-string:
    - meta_include_prototype: false
    - meta_scope: string.quoted.triple.single.raw.dart.joy
    - match: "'''"
      scope: punctuation.definition.string.end.dart.joy
      pop: true

  string-interpolation:
    - match: '(\$)({{identifier}})'
      captures:
        1: punctuation.definition.interpolation.dart.joy
        2: variable.other.interpolation.dart.joy
    - match: '(\$)(\{)'
      captures:
        1: punctuation.definition.interpolation.dart.joy
        2: punctuation.section.interpolation.begin.dart.joy
      push: interpolation-expression

  interpolation-expression:
    - meta_include_prototype: true
    - meta_scope: meta.interpolation.dart.joy
    - match: '\}'
      scope: punctuation.section.interpolation.end.dart.joy
      pop: true
    - include: expressions

  string-escapes:
    - match: '\\(?:[abfnrtv\\\x27"$]|x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\{[0-9A-Fa-f]{1,6}\})'
      scope: constant.character.escape.dart.joy
    - match: '\\.'
      scope: invalid.illegal.unknown-escape.dart.joy

  # ------------------------------------------------------------------
  # Comments and documentation
  # ------------------------------------------------------------------

  comments:
    - match: '///'
      scope: punctuation.definition.comment.documentation.dart.joy
      push: documentation-line-body
    - match: '//'
      scope: punctuation.definition.comment.dart.joy
      push: line-comment-body
    - match: '/\*\*'
      scope: punctuation.definition.comment.documentation.dart.joy
      push: documentation-block-body
    - match: '/\*'
      scope: punctuation.definition.comment.dart.joy
      push: block-comment-body
    - match: '\*/'
      scope: invalid.illegal.stray-comment-end.dart.joy

  line-comment-body:
    - meta_include_prototype: false
    - meta_scope: comment.line.double-slash.dart.joy
    - match: '$'
      pop: true
    - include: comment-markers
    - include: comment-links

  documentation-line-body:
    - meta_include_prototype: false
    - meta_scope: comment.line.documentation.dart.joy
    - match: '$'
      pop: true
    - include: documentation-markup
    - include: comment-markers
    - include: comment-links

  block-comment-body:
    - meta_include_prototype: false
    - meta_scope: comment.block.dart.joy
    - match: '/\*'
      scope: punctuation.definition.comment.begin.dart.joy
      push: block-comment-body
    - match: '\*/'
      scope: punctuation.definition.comment.end.dart.joy
      pop: true
    - include: comment-markers
    - include: comment-links

  documentation-block-body:
    - meta_include_prototype: false
    - meta_scope: comment.block.documentation.dart.joy
    - match: '/\*'
      scope: punctuation.definition.comment.begin.dart.joy
      push: block-comment-body
    - match: '\*/'
      scope: punctuation.definition.comment.end.dart.joy
      pop: true
    - include: documentation-markup
    - include: comment-markers
    - include: comment-links

  documentation-markup:
    - match: '\[({{identifier}}(?:\s*[.#]\s*{{identifier}})*)\]'
      scope: markup.underline.link.reference.documentation.dart.joy
    - match: '`[^`\n]+`'
      scope: markup.raw.inline.documentation.dart.joy
    - match: '(^|\s)(#{1,6})[ \t]+[^\n]+'
      scope: markup.heading.documentation.dart.joy
    - match: '(?<!\*)\*\*[^*\n]+\*\*'
      scope: markup.bold.documentation.dart.joy
    - match: '(?<!_)__[^_\n]+__'
      scope: markup.bold.documentation.dart.joy

  comment-markers:
    - match: '\b{{critical_marker}}\b(?=:|\b)'
      scope: markup.warning.critical.comment.dart.joy
    - match: '\b{{warning_marker}}\b(?=:|\b)'
      scope: markup.warning.comment.dart.joy
    - match: '\b{{notice_marker}}\b(?=:|\b)'
      scope: markup.note.comment.dart.joy

  comment-links:
    - match: '(?:https?|ftp)://[^\s<>\])}]+'
      scope: markup.underline.link.dart.joy

  merge-conflict-markers:
    - match: '^(<{7})(?:[ \t]+(.+))?$'
      scope: meta.block.conflict.begin.diff
      captures:
        1: punctuation.section.block.begin.diff
        2: entity.name.section.diff
    - match: '^(\|{7}|={7})(?:[ \t]+(.+))?$'
      scope: meta.block.conflict.separator.diff
      captures:
        1: punctuation.section.block.diff
        2: entity.name.section.diff
    - match: '^(>{7})(?:[ \t]+(.+))?$'
      scope: meta.block.conflict.end.diff
      captures:
        1: punctuation.section.block.end.diff
        2: entity.name.section.diff
